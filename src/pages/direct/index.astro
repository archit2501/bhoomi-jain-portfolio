---
import Icon from '../../components/Icon.astro';
import Conversations from '../../components/dm/Conversations.astro';
import DmShell from '../../components/dm/DmShell.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadSiteContent } from '../../lib/content';

const { dmThreads, profile } = await loadSiteContent();
const firstName = profile.displayName.split(/\s+/)[0];
---

<BaseLayout title="Messages" current="messages" image="/og/pages/direct.png">
  <DmShell phone="list">
    <Conversations slot="list" threads={dmThreads} profile={profile} headingLevel={1} />
    <section class="empty" aria-label="No conversation open">
      <span class="ring">
        <Icon name="messages" size={40} />
      </span>
      <p class="title">Message {firstName}</p>
      <p class="note">Pick what it's about on the left. Every message goes straight to her.</p>
    </section>
  </DmShell>
</BaseLayout>

<style>
  .empty {
    display: grid;
    place-items: center;
    align-content: center;
    gap: var(--space-2);
    min-height: 100dvh;
    padding: var(--space-8);
    text-align: center;
  }

  .ring {
    display: flex;
    padding: var(--space-4);
    border: 2px solid var(--text);
    border-radius: 50%;
  }

  .title {
    margin: 0;
    font-size: var(--fs-20);
    font-weight: var(--weight-semibold);
  }

  .note {
    margin: 0;
    color: var(--text-secondary);
  }
</style>
