---
import Avatar from '../components/Avatar.astro';
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadSiteContent } from '../lib/content';

const { dmThreads, profile } = await loadSiteContent();
const initials = profile.displayName
  .split(/\s+/)
  .map((part) => part[0])
  .join('')
  .slice(0, 2);
const firstName = profile.displayName.split(/\s+/)[0];
const mailto = (label: string) =>
  profile.links.email
    ? `mailto:${profile.links.email}?subject=${encodeURIComponent(`${label}, from your portfolio`)}`
    : undefined;
---

<!--
  Messages. Until the real inbox lands (task 3.2.1), each starter thread shows her first reply
  and hands the visitor to their own email app or LinkedIn, and says so.
-->
<BaseLayout title="Messages" current="messages" image="/og/pages/direct.png">
  <section class="direct" aria-labelledby="direct-title">
    <header class="direct-head">
      <h1 id="direct-title">Message {firstName}</h1>
      <p class="where">
        Messages open in your email app or on LinkedIn. Nothing is sent from this page.
      </p>
    </header>
    <ul class="threads" role="list">
      {dmThreads.map(({ id, data }) => (
        <li id={id} class="thread">
          <h2 class="thread-title">{data.label}</h2>
          <div class="bubble-row">
            <Avatar size={28} src={profile.avatar.src} alt="" initials={initials} />
            <p class="bubble">{data.opener}</p>
          </div>
          {!data.ai && (
            <p class="actions">
              {mailto(data.label) && (
                <a class="action" href={mailto(data.label)}>
                  <Icon name="mail" size={20} />
                  Email {firstName}
                </a>
              )}
              <a
                class="action"
                href={profile.links.linkedin}
                rel="noopener noreferrer"
                target="_blank"
              >
                <Icon name="link" size={20} />
                LinkedIn
              </a>
            </p>
          )}
          {data.ai && <p class="soon">The AI assistant is coming soon.</p>}
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .direct {
    max-width: 640px;
    margin: 0 auto;
    padding: var(--space-6) var(--space-4) var(--space-8);
  }

  .direct-head {
    margin-bottom: var(--space-4);
  }

  h1 {
    margin: 0;
    font-size: var(--fs-20);
    line-height: var(--lh-20);
    font-weight: var(--weight-bold);
  }

  .where,
  .soon {
    margin: var(--space-1) 0 0;
    color: var(--text-secondary);
    font-size: var(--fs-14);
    line-height: var(--lh-14);
  }

  .threads {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .thread {
    padding: var(--space-4);
    border: 1px solid var(--separator);
    border-radius: var(--radius-card);
    scroll-margin-top: var(--space-8);
  }

  .thread:target {
    border-color: var(--accent);
  }

  .thread-title {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-16);
    line-height: var(--lh-16);
    font-weight: var(--weight-semibold);
  }

  .bubble-row {
    display: flex;
    align-items: flex-end;
    gap: var(--space-2);
  }

  .bubble {
    max-width: 75%;
    margin: 0;
    padding: var(--space-2) var(--space-3);
    background: var(--bg-secondary);
    border-radius: var(--radius-bubble);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
  }

  .action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 32px;
    padding: 0 var(--space-4);
    color: var(--button-secondary-text);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    background: var(--button-secondary);
    border-radius: var(--radius-button);
  }

  @media (hover: hover) {
    .action:hover {
      background: var(--button-secondary-hover);
    }
  }
</style>
