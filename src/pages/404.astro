---
import ExploreGrid from '../components/explore/ExploreGrid.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadSiteContent } from '../lib/content';

// Instagram's "not available" page, with a way back to her profile and the Explore grid below.
const { profile, posts, reels, highlights } = await loadSiteContent();
const firstName = profile.displayName.split(/\s+/)[0];
const ordered = [...posts].sort((a, b) => a.data.order - b.data.order);
const row = highlights.filter((h) => h.data.inRow);
---

<BaseLayout title="Page not found" description="Sorry, this page isn't available.">
  <section class="not-found" aria-labelledby="not-found-title">
    <h1 id="not-found-title">Sorry, this page isn't available.</h1>
    <p>
      The link you followed may be broken, or the page may have been removed.{' '}
      <a href="/">Go back to {firstName}'s profile.</a>
    </p>
  </section>
  <section class="more" aria-labelledby="more-title">
    <h2 id="more-title">More to explore</h2>
    <ExploreGrid posts={ordered} reels={reels} highlights={row} />
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    justify-items: center;
    gap: var(--space-6);
    max-width: 935px;
    margin: 0 auto;
    padding: 40px var(--space-4);
    text-align: center;
  }

  h1 {
    margin: 0;
    font-size: var(--fs-24);
    line-height: var(--lh-24);
    font-weight: var(--weight-semibold);
  }

  p {
    margin: 0;
    font-size: var(--fs-16);
    line-height: var(--lh-16);
  }

  a {
    color: var(--accent-text);
    font-weight: var(--weight-semibold);
    text-decoration: none;
  }

  @media (hover: hover) {
    a:hover {
      text-decoration: underline;
    }
  }

  .more {
    max-width: 935px;
    margin: 0 auto;
    padding: 0 0 var(--space-8);
    border-top: 1px solid var(--separator);
  }

  h2 {
    margin: 0;
    padding: var(--space-6) var(--space-4) var(--space-4);
    font-size: var(--fs-16);
    line-height: var(--lh-16);
    font-weight: var(--weight-semibold);
    color: var(--text-secondary);
  }
</style>
