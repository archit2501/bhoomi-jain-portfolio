---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadSiteContent } from '../lib/content';

const { profile } = await loadSiteContent();
const firstName = profile.displayName.split(/\s+/)[0];
---

<BaseLayout title="Page not found" description="This page isn't here.">
  <section class="not-found">
    <h1>This page isn't here</h1>
    <p>The link may be broken, or the page may have moved.</p>
    <a href="/">Go back to {firstName}'s profile</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    max-width: 935px;
    margin: 0 auto;
    padding: 40px var(--space-4);
    text-align: center;
  }

  h1 {
    margin: 0;
    font-size: var(--fs-24);
    line-height: var(--lh-24);
    font-weight: var(--weight-semibold);
  }

  p {
    margin: 0;
    font-size: var(--fs-16);
    line-height: var(--lh-16);
  }

  a {
    color: var(--accent-text);
    font-weight: var(--weight-semibold);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }
</style>
