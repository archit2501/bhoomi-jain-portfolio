---
import Cover from '../../components/covers/Cover.astro';
import Icon from '../../components/Icon.astro';
import Media from '../../components/Media.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadSiteContent } from '../../lib/content';
import { storyArt } from '../../lib/story/art';

export async function getStaticPaths() {
  const { highlights } = await loadSiteContent();
  return highlights.map((highlight, index) => ({
    params: { id: highlight.id },
    props: { highlight, index },
  }));
}

const { highlight, index } = Astro.props;
const { label, frames } = highlight.data;
// Each story printed as in the viewer (task 6.4.2): same field, same layout, same page number.
const arts = storyArt(highlight, index);
---

<BaseLayout title={`${label} highlights`} current="profile" image={`/og/s/${highlight.id}.png`}>
  <article class="story-page">
    <a class="back" href="/">
      <Icon name="back" size={20} />
      <span>Back to profile</span>
    </a>
    <h1>{label}</h1>
    <ol role="list">
      {frames.map((frame, i) => (
        <li class:list={['frame', { printed: arts[i].cover }]} data-field={arts[i].field}>
          {frame.type === 'image' ? (
            <figure>
              <Media
                class="frame-photo"
                src={frame.src}
                alt={frame.alt}
                widths={[360, 540, 720, 940]}
                sizes="(min-width: 470px) 470px, 100vw"
                priority={i === 0}
              />
              {frame.caption && <figcaption>{frame.caption}</figcaption>}
            </figure>
          ) : (
            arts[i].cover && <Cover cover={arts[i].cover} mark={arts[i].mark} story />
          )}
        </li>
      ))}
    </ol>
  </article>
</BaseLayout>

<style>
  .story-page {
    max-width: 470px;
    margin: 0 auto;
    padding: var(--space-4);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--text-secondary);
    text-decoration: none;
  }

  h1 {
    margin: var(--space-4) 0;
    font-size: var(--fs-20);
    line-height: var(--lh-20);
  }

  ol {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .frame {
    overflow: hidden;
    border-radius: var(--radius-card);
  }

  /* A printed story keeps the post slides' shape, so its cover lays out as theirs do. */
  .frame.printed {
    --story-top: 7cqi;
    aspect-ratio: 4 / 5;
  }

  figure {
    margin: 0;
  }

  .frame-photo {
    border-radius: var(--radius-button);
  }
</style>
