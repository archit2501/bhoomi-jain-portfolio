---
import FeedCard from '../components/feed/FeedCard.astro';
import FeedRail from '../components/feed/FeedRail.astro';
import StoriesTray from '../components/feed/StoriesTray.astro';
import Icon from '../components/Icon.astro';
import StoryViewer from '../components/story/StoryViewer.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadSiteContent } from '../lib/content';
import { feedOrder, lensesOf, LENSES, type Lens } from '../lib/feed';

// Home as a dev log (task 4.1.3): her stories, then her work, newest first.
const { posts, profile, resume, highlights } = await loadSiteContent();
const feed = feedOrder(posts).map((post) => ({ post, lenses: lensesOf(post, resume) }));
const counts = Object.fromEntries(
  LENSES.map(({ id }) => [
    id,
    id === 'all' ? feed.length : feed.filter((f) => f.lenses.includes(id as Lens)).length,
  ]),
) as Record<Lens | 'all', number>;
const intro = highlights.find((h) => h.data.inRow === false);
const row = highlights.filter((h) => h.data.inRow !== false);
const firstName = profile.displayName.split(/\s+/)[0];
---

<BaseLayout title="Home" current="home" image="/og/pages/feed.png">
  <div class="home">
    <section class="feed-column" aria-labelledby="feed-title">
      <h1 id="feed-title" class="visually-hidden">
        Home
      </h1>
      <StoriesTray profile={profile} intro={intro} highlights={row} />
      <p class="visually-hidden" role="status" data-feed-status></p>
      <div class="feed" data-feed>
        {feed.map(({ post, lenses }, i) => (
          <FeedCard post={post} profile={profile} lenses={lenses} eager={i === 0} />
        ))}
      </div>
      <section class="caught-up" aria-labelledby="caught-up-title">
        <span class="check" aria-hidden="true">
          <Icon name="check" size={32} />
        </span>
        <h2 id="caught-up-title">You're all caught up</h2>
        <p>You've seen all of {firstName}'s posts.</p>
        <a href="/">View her profile</a>
      </section>
    </section>
    <FeedRail profile={profile} counts={counts} />
  </div>
  <StoryViewer highlights={highlights} profile={profile} />
</BaseLayout>

<script>
  import { initFeed } from '../scripts/feed';

  initFeed();
</script>

<style>
  .home {
    display: flex;
    justify-content: center;
    gap: 64px;
  }

  /* min-width: 0, or the stories tray's row would widen the column past the screen. */
  .feed-column {
    width: 100%;
    min-width: 0;
    max-width: 470px;
    padding-bottom: var(--space-8);
  }

  .feed {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }

  /* The lens switch hides what it doesn't cover; "All" shows every post. */
  .feed[data-lens='frontend'] > :global(.feed-card:not([data-lenses~='frontend'])),
  .feed[data-lens='backend'] > :global(.feed-card:not([data-lenses~='backend'])),
  .feed[data-lens='ai'] > :global(.feed-card:not([data-lenses~='ai'])) {
    display: none;
  }

  /* "You're all caught up": a check in her ring, and the way back to her profile. */
  .caught-up {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    padding: var(--space-8) var(--space-4);
    text-align: center;
  }

  .check {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    margin-bottom: var(--space-2);
    color: var(--text);
    background:
      linear-gradient(var(--bg), var(--bg)) padding-box,
      var(--ring) border-box;
    border: 2px solid transparent;
    border-radius: 50%;
  }

  .caught-up h2 {
    margin: 0;
    font-size: var(--fs-20);
    line-height: var(--lh-20);
    font-weight: var(--weight-regular);
  }

  .caught-up p {
    margin: 0;
    font-size: var(--fs-14);
    line-height: var(--lh-14);
    color: var(--text-secondary);
  }

  .caught-up a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    font-size: var(--fs-14);
    font-weight: var(--weight-semibold);
    color: var(--accent-text);
    text-decoration: none;
  }

  .home > :global(.rail) {
    display: none;
  }

  @media (min-width: 470px) {
    .feed-column {
      padding-top: var(--space-4);
    }
  }

  /* The rail joins at instagram.com's width. */
  @media (min-width: 1160px) {
    .home > :global(.rail) {
      display: grid;
      position: sticky;
      top: 0;
      align-self: flex-start;
    }
  }
</style>
