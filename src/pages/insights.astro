---
import GithubPanel from '../components/insights/GithubPanel.astro';
import LighthousePanel from '../components/insights/LighthousePanel.astro';
import ResumePanel from '../components/insights/ResumePanel.astro';
import TotalsPanel from '../components/insights/TotalsPanel.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadSiteContent } from '../lib/content';

// Her "professional dashboard" (task 4.2.2): every number with where it's from and when.
const { figures, posts, resume } = await loadSiteContent();
const stats = Object.entries(figures).filter(([, f]) => f.verified);
const year = resume.source.match(/\b(20\d\d)\b/)?.[1] ?? null;
---

<BaseLayout title="Insights" current="insights" image="/og/pages/insights.png">
  <div class="insights">
    <header>
      <h1>Insights</h1>
      <p class="lede">Every number here says where it comes from and when it was true.</p>
    </header>
    <GithubPanel />
    <LighthousePanel />
    <TotalsPanel />
    <ResumePanel figures={stats} posts={posts} year={year} />
  </div>
</BaseLayout>

<script>
  import { initInsights } from '../scripts/insights';

  initInsights();
</script>

<style>
  /* minmax(0, 1fr): the heatmap and the scores table scroll on their own, not the page. */
  .insights {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
    max-width: 935px;
    margin: 0 auto;
    padding: var(--space-6) var(--space-4) var(--space-8);
  }

  h1 {
    margin: 0;
    font-size: var(--fs-24);
    line-height: var(--lh-24);
    font-weight: var(--weight-semibold);
  }

  .lede {
    margin: var(--space-1) 0 0;
    color: var(--text-secondary);
  }

  /* Shared by the panels in src/components/insights. */
  .insights :global(.panel h2) {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-16);
    line-height: var(--lh-16);
    font-weight: var(--weight-semibold);
  }

  .insights :global(.state) {
    margin: 0;
    color: var(--text-secondary);
  }

  .insights :global(.state:empty),
  .insights :global([hidden]) {
    display: none;
  }

  .insights :global(.tiles) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .insights :global(.tile) {
    padding: var(--space-4);
    background: var(--bg-secondary);
    border-radius: var(--radius-card);
  }

  .insights :global(.tile p) {
    margin: 0;
  }

  .insights :global(.value) {
    font-family: var(--font-display);
    font-size: var(--fs-28);
    line-height: var(--lh-28);
    font-weight: var(--weight-bold);
    font-variant-numeric: tabular-nums;
  }

  .insights :global(.label) {
    margin-top: var(--space-1);
    font-weight: var(--weight-semibold);
  }

  .insights :global(.source) {
    margin: var(--space-3) 0 0;
    color: var(--text-secondary);
    font-size: var(--fs-12);
    line-height: var(--lh-12);
  }

  .insights :global(.tile .source) {
    margin-top: var(--space-2);
  }

  .insights :global(.source a) {
    color: var(--accent-text);
  }
</style>
