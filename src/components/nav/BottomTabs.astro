---
import NavIcon from './NavIcon.astro';
import { NAV_ITEMS, type NavId } from './nav-items';

interface Props {
  current?: NavId;
}

const { current } = Astro.props;
---

<nav class="bottom-tabs" aria-label="Primary">
  <ul role="list">
    {NAV_ITEMS.map((item) => (
      <li>
        <a
          class="tab"
          href={item.href}
          aria-current={item.id === current ? 'page' : undefined}
          data-open-contact={item.opensContact ? '' : undefined}
        >
          <NavIcon name={item.id} active={item.id === current} />
          <span class="visually-hidden">{item.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .bottom-tabs {
    position: fixed;
    inset: auto 0 0;
    z-index: 20;
    padding-bottom: env(safe-area-inset-bottom, 0px);
    padding-left: env(safe-area-inset-left, 0px);
    padding-right: env(safe-area-inset-right, 0px);
    background: var(--bg);
    border-top: 1px solid var(--separator);
  }

  @media (min-width: 768px) {
    .bottom-tabs {
      display: none;
    }
  }

  ul {
    display: flex;
    justify-content: space-around;
    height: 49px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    flex: 1;
  }

  .tab {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    color: var(--text);
    border-radius: var(--radius-button);
  }
</style>
