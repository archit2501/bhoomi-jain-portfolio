---
import NavIcon from './NavIcon.astro';
import { BOTTOM_TABS, type NavId } from './nav-items';

interface Props {
  current?: NavId;
}

const { current } = Astro.props;
// On a phone the Explore page is the Search tab, as in the app.
const activeTab = current === 'explore' ? 'search' : current;
---

<nav class="bottom-tabs" aria-label="Primary">
  <ul role="list">
    {BOTTOM_TABS.map((item) => (
      <li>
        <a class="tab" href={item.href} aria-current={item.id === activeTab ? 'page' : undefined}>
          <NavIcon item={item} active={item.id === activeTab} />
          <span class="visually-hidden">{item.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .bottom-tabs {
    position: fixed;
    inset: auto 0 0;
    z-index: 20;
    padding-bottom: env(safe-area-inset-bottom, 0px);
    padding-left: env(safe-area-inset-left, 0px);
    padding-right: env(safe-area-inset-right, 0px);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: saturate(180%) blur(20px);
    border-top: 1px solid var(--separator);
  }

  @media (min-width: 768px) {
    .bottom-tabs {
      display: none;
    }
  }

  ul {
    display: flex;
    justify-content: space-around;
    height: var(--bottom-bar-h);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    flex: 1;
  }

  .tab {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    color: var(--text);
    border-radius: var(--radius-button);
    -webkit-tap-highlight-color: transparent;
  }

  .tab :global(svg),
  .tab :global(.nav-avatar) {
    transition: transform var(--dur-press) var(--ease-ig);
  }

  .tab:active :global(svg),
  .tab:active :global(.nav-avatar) {
    transform: scale(var(--press-scale-icon));
  }
</style>
