---
import Wordmark from '../../assets/wordmark.svg';
---

<header class="app-bar">
  <a class="logo" href="/" aria-label="bhoomi, home">
    <Wordmark height={26} aria-hidden="true" />
  </a>
</header>

<style>
  .app-bar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    min-height: calc(44px + env(safe-area-inset-top, 0px));
    padding: env(safe-area-inset-top, 0px) max(var(--space-4), env(safe-area-inset-right, 0px)) 0
      max(var(--space-4), env(safe-area-inset-left, 0px));
    background: var(--bg);
    border-bottom: 1px solid var(--separator);
  }

  @media (min-width: 768px) {
    .app-bar {
      display: none;
    }
  }

  .logo {
    display: flex;
    color: var(--text);
    border-radius: var(--radius-button);
  }
</style>
