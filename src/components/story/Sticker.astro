---
/**
 * One of Instagram's story stickers, static: a link, an @mention, a location or (hers alone) a
 * line of code. Placed by its centre over the frame. Links and mentions are real links; the
 * viewer pauses while one has focus, so it can't slide away mid-Tab.
 */
import type { Sticker } from '../../lib/content-schema';
import { stickerStyle, stickerText } from '../../lib/story/stickers';
import Icon from '../Icon.astro';

interface Props {
  sticker: Sticker;
}

const { sticker } = Astro.props;
const label = stickerText(sticker);
const style = stickerStyle(sticker);
---

{sticker.type === 'link' && (
  <a
    class="sticker sticker-link"
    href={sticker.href}
    target="_blank"
    rel="noopener noreferrer"
    style={style}
    data-sticker="link"
  >
    <Icon name="link" size={18} />
    <span>{label}</span>
  </a>
)}
{sticker.type === 'mention' && (
  <a class="sticker sticker-mention" href={sticker.href} style={style} data-sticker="mention">
    <span>{label}</span>
  </a>
)}
{sticker.type === 'location' && (
  <span class="sticker sticker-location" style={style} data-sticker="location">
    <Icon name="location" filled size={18} />
    <span>{label}</span>
  </span>
)}
{sticker.type === 'poll' && (
  <div
    class="sticker sticker-live sticker-poll"
    style={style}
    data-sticker="poll"
    data-poll={sticker.id}
  >
    <p class="live-prompt">{sticker.question}</p>
    <div class="poll-options" role="group" aria-label={sticker.question}>
      {sticker.options.map((option, i) => (
        <button type="button" class="poll-option" data-choice={i}>
          <span class="poll-fill" aria-hidden="true" />
          <span class="poll-label">{option}</span>
          <span class="poll-pct" />
        </button>
      ))}
    </div>
    <p class="live-status" role="status" />
  </div>
)}
{sticker.type === 'question' && (
  <form
    class="sticker sticker-live sticker-question"
    style={style}
    data-sticker="question"
    data-question={sticker.id}
  >
    <p class="live-prompt">{sticker.prompt}</p>
    <label class="visually-hidden" for={`q-${sticker.id}`}>
      {sticker.prompt}
    </label>
    <textarea
      id={`q-${sticker.id}`}
      name="body"
      rows="2"
      maxlength="500"
      placeholder="Type something…"
      required
    />
    <button type="submit" class="live-send">
      Send
    </button>
    <p class="live-status" role="status" />
  </form>
)}
{sticker.type === 'slider' && (
  <div
    class="sticker sticker-live sticker-slider"
    style={`${style}; --emoji: '${sticker.emoji}'`}
    data-sticker="slider"
    data-slider={sticker.id}
  >
    <p class="live-prompt">{sticker.prompt}</p>
    <input type="range" min="0" max="100" step="1" value="50" aria-label={sticker.prompt} />
    <p class="slider-emoji" aria-hidden="true">
      {sticker.emoji}
    </p>
    <p class="live-status" role="status" />
  </div>
)}
{sticker.type === 'code' && (
  <code class="sticker sticker-code" style={style} data-sticker="code">
    <Icon name="code" size={16} />
    <span>{label}</span>
  </code>
)}

<style>
  .sticker {
    position: absolute;
    top: var(--y);
    left: var(--x);
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    max-width: 82%;
    min-height: 40px;
    padding: 8px 12px;
    font-family: var(--font-display);
    font-size: var(--fs-16);
    line-height: 1.2;
    font-weight: var(--weight-bold);
    letter-spacing: 0;
    color: var(--sticker-ink);
    text-decoration: none;
    white-space: nowrap;
    background: var(--sticker-bg);
    border-radius: 10px;
    box-shadow: 0 2px 12px rgb(0 0 0 / 28%);
    transform: translate(-50%, -50%) rotate(var(--rotate));
  }

  .sticker > span {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sticker :global(.icon) {
    flex: none;
  }

  .sticker-link,
  .sticker-location {
    text-transform: uppercase;
  }

  /* The mention reads in her gradient, large and bold so it keeps 3:1 against the white card. */
  .sticker-mention {
    font-size: var(--fs-20);
    text-transform: uppercase;
  }

  .sticker-mention > span {
    color: var(--sticker-mention-2);
    background: linear-gradient(90deg, var(--sticker-mention-1), var(--sticker-mention-2));
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .sticker-code {
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    font-weight: var(--weight-regular);
    color: var(--sticker-code-ink);
    background: var(--sticker-code-bg);
    border: 1px solid rgb(255 255 255 / 24%);
  }

  /* ---- interactive stickers: a white card, wider, never tilted past readability ---- */
  .sticker-live {
    display: grid;
    gap: var(--space-2);
    width: min(78%, 300px);
    max-width: none;
    padding: var(--space-3);
    white-space: normal;
    text-align: center;
    color: #0c1014;
    text-transform: none;
  }

  .live-prompt {
    margin: 0;
    font-size: var(--fs-16);
    line-height: 1.25;
  }

  .poll-options {
    display: grid;
    gap: var(--space-2);
  }

  .poll-option {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: 40px;
    padding: var(--space-2) var(--space-3);
    overflow: hidden;
    font: inherit;
    font-weight: var(--weight-bold);
    color: var(--sticker-ink);
    background: #f3f5f7;
    border: 0;
    border-radius: var(--radius-button);
    cursor: pointer;
  }

  .poll-option:disabled {
    cursor: default;
  }

  .poll-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--pct, 0%);
    background: rgb(3 105 161 / 18%);
    transition: width 0.4s var(--ease-ig);
  }

  .poll-option.mine .poll-fill {
    background: rgb(3 105 161 / 32%);
  }

  .poll-label,
  .poll-pct {
    position: relative;
  }

  .sticker-question textarea {
    width: 100%;
    padding: var(--space-2);
    font: inherit;
    font-weight: var(--weight-regular);
    color: #0c1014;
    background: #f3f5f7;
    border: 0;
    border-radius: var(--radius-button);
    resize: none;
  }

  .live-send {
    justify-self: center;
    padding: var(--space-2) var(--space-4);
    font: inherit;
    font-weight: var(--weight-bold);
    color: var(--on-accent);
    background: var(--sticker-ink);
    border: 0;
    border-radius: var(--radius-pill);
    cursor: pointer;
  }

  .sticker-slider input[type='range'] {
    width: 100%;
    accent-color: var(--sticker-ink);
  }

  .slider-emoji {
    margin: 0;
    font-size: 28px;
    line-height: 1;
  }

  .live-status {
    margin: 0;
    font-size: var(--fs-12);
    font-weight: var(--weight-regular);
    color: #4b5259;
  }

  .live-status:empty {
    display: none;
  }

  a.sticker:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: no-preference) {
    a.sticker {
      transition: scale var(--dur-press) var(--ease-out);
    }

    a.sticker:active {
      scale: var(--press-scale-button);
    }
  }
</style>
