---
import Icon from '../Icon.astro';
import { Picture } from 'astro:assets';
import type { Highlight, Profile } from '../../lib/content-schema';
import { mediaImage } from '../../lib/media';
import { pageTitle } from '../../lib/site';
import { frameDuration } from '../../lib/story/controller';
import Avatar from '../Avatar.astro';

interface Props {
  highlights: { id: string; data: Highlight }[];
  profile: Profile;
}

const { highlights, profile } = Astro.props;
const words = (...parts: (string | undefined)[]) =>
  parts.filter(Boolean).join(' ').split(/\s+/).filter(Boolean).length;
const initials = profile.displayName
  .split(/\s+/)
  .map((part) => part[0])
  .join('')
  .slice(0, 2);
---

<dialog id="story-viewer" class="story-viewer" aria-label="Stories">
  <div class="stage">
    <button class="peek peek-prev" type="button" hidden>
      <span class="peek-cover" aria-hidden="true"></span>
      <span class="peek-label"></span>
    </button>

    <div class="card-wrap">
      <button class="frame-nav frame-prev" type="button" aria-label="Previous story">
        <Icon name="back" size={20} />
      </button>

      <div class="card">
        <div class="frames"></div>
        <div class="scrim" aria-hidden="true"></div>
        <div class="progress" aria-hidden="true"></div>
        <div class="story-head">
          <Avatar size={32} src={profile.avatar.src} alt="" initials={initials} />
          <p class="who">
            <span class="username">{profile.username}</span>
            <span class="group-label"></span>
          </p>
          <button class="icon-btn pause" type="button" aria-label="Pause" autofocus>
            <Icon name="pause" filled class="icon-pause" size={22} />
            <Icon name="play" filled class="icon-play" size={22} />
          </button>
          <button class="icon-btn story-close" type="button" aria-label="Close">
            <Icon name="close" size={26} />
          </button>
        </div>
        <p class="story-status visually-hidden" aria-live="polite"></p>
      </div>

      <button class="frame-nav frame-next" type="button" aria-label="Next story">
        <Icon name="forward" size={20} />
      </button>
    </div>

    <button class="peek peek-next" type="button" hidden>
      <span class="peek-cover" aria-hidden="true"></span>
      <span class="peek-label"></span>
    </button>
  </div>
</dialog>

{highlights.map(({ id, data }) => (
  <template
    data-story-group={id}
    data-label={data.label}
    data-cover={data.cover.type === 'text' ? data.cover.text : ''}
    data-title={pageTitle(`${data.label} highlights`)}
  >
    {data.frames.map((frame, i) => (
      <div
        class={`frame tone-${(i % 3) + 1}`}
        role="group"
        aria-roledescription="story"
        aria-label={`${i + 1} of ${data.frames.length}`}
        data-duration={frameDuration({
          durationMs: frame.durationMs,
          words: frame.type === 'text' ? words(frame.heading, frame.body) : undefined,
        })}
      >
        {frame.type === 'image' ? (
          <>
            <Picture
              src={mediaImage(frame.src)}
              alt={frame.alt}
              formats={['avif', 'webp']}
              widths={[480, 720, 1080]}
              sizes="(min-width: 768px) 480px, 100vw"
              loading="lazy"
            />
            {frame.caption && <p class="frame-caption">{frame.caption}</p>}
          </>
        ) : (
          <div class="text-frame">
            {frame.heading && <p class="frame-heading">{frame.heading}</p>}
            <p class="frame-body">{frame.body}</p>
          </div>
        )}
      </div>
    ))}
  </template>
))}

<script>
  import { initStoryViewer } from '../../scripts/story-viewer';

  initStoryViewer();
</script>

<style>
  .story-viewer {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    color: #ffffff;
    background: #000000;
    border: 0;
    overscroll-behavior: contain;
  }

  .story-viewer::backdrop {
    background: #000000;
  }

  .stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    place-items: center;
    height: 100%;
  }

  .card-wrap {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .card {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: linear-gradient(160deg, var(--story-start), var(--story-end));
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    transition: transform 0.2s cubic-bezier(0.17, 0.17, 0, 1);
  }

  .card.dragging {
    transition: none;
  }

  .frames :global(.frame) {
    position: absolute;
    inset: 0;
    display: none;
  }

  .frames :global(.frame.active) {
    display: flex;
  }

  /* Text stories rotate through the same three colour fields as the grid. */
  .frames :global(.frame.tone-1) {
    background: linear-gradient(160deg, var(--story-start), var(--story-end));
  }

  .frames :global(.frame.tone-2) {
    background: linear-gradient(160deg, var(--tile-slate), var(--story-end));
  }

  .frames :global(.frame.tone-3) {
    background: var(--accent);
  }

  .frames :global(.frame img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .frames :global(.text-frame) {
    font-family: var(--font-display);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-3);
    width: 100%;
    padding: 72px var(--space-6) var(--space-11);
  }

  .frames :global(.frame-heading) {
    margin: 0;
    font-size: clamp(26px, 8vw, 36px);
    line-height: 1.15;
    font-weight: var(--weight-bold);
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }

  .frames :global(.frame-body) {
    margin: 0;
    font-size: var(--fs-20);
    line-height: 1.35;
    letter-spacing: 0;
  }

  .frames :global(.frame-caption) {
    position: absolute;
    inset: auto var(--space-4) var(--space-8);
    margin: 0;
    padding: var(--space-2) var(--space-3);
    background: rgb(0 0 0 / 55%);
    border-radius: var(--radius-button);
  }

  .scrim {
    position: absolute;
    inset: 0 0 auto;
    height: 96px;
    background: linear-gradient(rgb(0 0 0 / 45%), transparent);
    pointer-events: none;
  }

  .progress {
    position: absolute;
    top: calc(var(--space-2) + env(safe-area-inset-top, 0px));
    right: var(--space-2);
    left: var(--space-2);
    display: flex;
    gap: var(--space-1);
  }

  .progress :global(.bar) {
    flex: 1;
    height: 2px;
    overflow: hidden;
    background: rgb(255 255 255 / 35%);
    border-radius: 1px;
  }

  .progress :global(.fill) {
    display: block;
    height: 100%;
    background: #ffffff;
    transform: scaleX(0);
    transform-origin: left center;
  }

  .story-head {
    position: absolute;
    top: calc(18px + env(safe-area-inset-top, 0px));
    right: var(--space-1);
    left: var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .who {
    flex: 1;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .username {
    font-weight: var(--weight-semibold);
  }

  .group-label {
    margin-left: var(--space-1);
  }

  .icon-btn {
    display: flex;
    padding: var(--space-2);
    color: #ffffff;
    background: none;
    border: 0;
    border-radius: var(--radius-button);
    cursor: pointer;
  }

  .icon-btn:focus-visible,
  .frame-nav:focus-visible,
  .peek:focus-visible {
    outline-color: #ffffff;
  }

  .pause :global(.icon-play),
  .pause[aria-label='Play'] :global(.icon-pause) {
    display: none;
  }

  .pause[aria-label='Play'] :global(.icon-play) {
    display: block;
  }

  .scrim,
  .progress,
  .story-head {
    transition: opacity 0.2s ease;
  }

  .chrome-hidden .scrim,
  .chrome-hidden .progress,
  .chrome-hidden .story-head {
    opacity: 0;
  }

  .frame-nav,
  .peek {
    display: none;
  }

  @media (min-width: 768px) {
    .story-viewer,
    .story-viewer::backdrop {
      background: #1a1a1a;
    }

    .stage {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      /* Wide enough that the previews never cover the chevrons 16-48px outside the card. */
      gap: 64px;
    }

    /* Fixed columns: a hidden preview must not shift the card out of the centre. */
    .peek-prev {
      grid-area: 1 / 1;
    }

    .card-wrap {
      grid-area: 1 / 2;
      width: auto;
      height: calc(100dvh - 32px);
      aspect-ratio: 9 / 16;
    }

    .peek-next {
      grid-area: 1 / 3;
    }

    .card {
      border-radius: 8px;
    }

    .frame-nav {
      position: absolute;
      top: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      padding: 0;
      color: #0c1014;
      background: rgb(255 255 255 / 85%);
      border: 0;
      border-radius: 50%;
      transform: translateY(-50%);
      cursor: pointer;
    }

    .frame-prev {
      left: -48px;
    }

    .frame-next {
      right: -48px;
    }

    .peek:not([hidden]) {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: var(--space-3);
      height: 40%;
      aspect-ratio: 9 / 16;
      padding: var(--space-3);
      color: #ffffff;
      background: linear-gradient(160deg, var(--story-start), var(--story-end));
      border: 0;
      border-radius: 8px;
      filter: brightness(0.55);
      cursor: pointer;
      transition: filter 0.15s ease;
    }

    .peek:hover {
      filter: brightness(0.75);
    }

    .peek-prev {
      justify-self: end;
    }

    .peek-next {
      justify-self: start;
    }

    .peek-cover {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 56px;
      height: 56px;
      font-size: var(--fs-20);
      font-weight: var(--weight-semibold);
      background: rgb(255 255 255 / 15%);
      border-radius: 50%;
    }

    .peek-label {
      font-weight: var(--weight-semibold);
    }
  }
</style>
