---
/**
 * Insights: her GitHub, from the hourly snapshot (src/workers/github-sync.ts). Filled by
 * src/scripts/insights.ts; GitHub's own numbers "as of" the sync, or "unavailable".
 */
---

<section class="panel" aria-labelledby="github-title" data-github>
  <h2 id="github-title">GitHub</h2>
  <p class="state" data-github-state>
    Her GitHub activity needs JavaScript to show.
  </p>
  <div data-github-body hidden>
    <ul class="tiles" role="list" data-github-figures>
      <li class="tile">
        <p class="value" data-figure="contributionsLastYear"></p>
        <p class="label">Contributions in the past year</p>
      </li>
      <li class="tile">
        <p class="value" data-figure="commitsThisYear"></p>
        <p class="label">Commits this year</p>
      </li>
      <li class="tile">
        <p class="value" data-figure="publicRepos"></p>
        <p class="label">Public repositories</p>
      </li>
    </ul>

    <figure class="heatmap">
      <div
        class="heat-scroll"
        role="group"
        tabindex="0"
        aria-label="Contribution calendar, scrolls sideways"
      >
        <div class="heat-months" aria-hidden="true" data-heat-months></div>
        <div class="heat" role="img" data-heat></div>
      </div>
      <figcaption class="legend" aria-hidden="true">
        <span>Less</span>
        {[0, 1, 2, 3, 4].map((level) => (
          <span class="cell" data-level={level} />
        ))}
        <span>More</span>
      </figcaption>
    </figure>
    <table class="visually-hidden" data-heat-table>
      <caption>Contributions by month</caption>
      <thead>
        <tr>
          <th scope="col">Month</th>
          <th scope="col">Contributions</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>

    <h3>Recently pushed</h3>
    <ul class="repos" role="list" data-repos></ul>
  </div>
  <p class="source" data-github-source hidden>
    From{' '}
    <a data-github-link href="https://github.com/">
      GitHub
    </a>
    , <span data-github-asof></span>
  </p>
</section>

<style>
  .heatmap {
    margin: var(--space-4) 0 0;
  }

  .heat-scroll {
    position: relative;
    overflow-x: auto;
    padding-bottom: var(--space-1);
    border-radius: var(--radius-button);
  }

  /* One column per week, Sunday at the top, as GitHub draws it. */
  .heat,
  .heat-months {
    --cell: 11px;
    display: grid;
    grid-auto-columns: var(--cell);
    grid-auto-flow: column;
    gap: 3px;
    width: max-content;
  }

  .heat {
    grid-template-rows: repeat(7, var(--cell));
  }

  .heat-months {
    height: 16px;
    font-size: var(--fs-12);
    line-height: var(--lh-12);
    color: var(--text-secondary);
  }

  .heat-months :global(span) {
    grid-row: 1;
    white-space: nowrap;
  }

  .heatmap :global(.cell) {
    display: block;
    width: var(--cell, 11px);
    height: var(--cell, 11px);
    background: var(--bg-secondary);
    border-radius: 2px;
    outline: 1px solid rgb(127 127 127 / 12%);
    outline-offset: -1px;
  }

  .heatmap :global(.cell[data-level='1']) {
    background: var(--heat-1);
  }

  .heatmap :global(.cell[data-level='2']) {
    background: var(--heat-2);
  }

  .heatmap :global(.cell[data-level='3']) {
    background: var(--heat-3);
  }

  .heatmap :global(.cell[data-level='4']) {
    background: var(--heat-4);
  }

  .heatmap :global(.cell.empty) {
    visibility: hidden;
  }

  .legend {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 3px;
    margin-top: var(--space-2);
    font-size: var(--fs-12);
    line-height: var(--lh-12);
    color: var(--text-secondary);
  }

  .legend span:first-child {
    margin-right: var(--space-1);
  }

  .legend span:last-child {
    margin-left: var(--space-1);
  }

  h3 {
    margin: var(--space-6) 0 var(--space-2);
    font-size: var(--fs-14);
    line-height: var(--lh-14);
    font-weight: var(--weight-semibold);
  }

  .repos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .repos :global(li) {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--separator);
    border-radius: var(--radius-card);
  }

  .repos :global(a) {
    font-weight: var(--weight-semibold);
    color: var(--accent-text);
    text-decoration: none;
  }

  .repos :global(p) {
    margin: var(--space-1) 0 0;
    font-size: var(--fs-12);
    line-height: var(--lh-12);
    color: var(--text-secondary);
  }
</style>
