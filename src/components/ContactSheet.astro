---
import Icon from './Icon.astro';
import type { Profile } from '../lib/content-schema';

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
const { links } = profile;
const linkedinLabel = links.linkedin.replace(/^https?:\/\/(www\.)?/, '');
---

<dialog id="contact-sheet" class="sheet" aria-labelledby="contact-title">
  <div class="panel">
    <div class="head">
      <h2 id="contact-title">Links</h2>
      <button class="close" type="button" data-close aria-label="Close">
        <Icon name="close" size={24} />
      </button>
    </div>
    <ul role="list">
      <li>
        <a class="row" href={links.linkedin} target="_blank" rel="noopener noreferrer">
          <Icon name="link" size={22} />
          <span>
            <span class="row-title">LinkedIn</span>
            <span class="row-detail">{linkedinLabel}</span>
          </span>
        </a>
      </li>
      {links.email && (
        <li class="row">
          <Icon name="mail" size={22} />
          <a class="row-main" href={`mailto:${links.email}`}>
            <span class="row-title">Email</span>
            <span class="row-detail">{links.email}</span>
          </a>
          <button
            class="copy"
            type="button"
            data-copy={links.email}
            aria-label="Copy email address"
          >
            <Icon name="copy" size={20} />
          </button>
        </li>
      )}
      {links.github && (
        <li>
          <a class="row" href={links.github} target="_blank" rel="noopener noreferrer">
            <Icon name="github" size={22} />
            <span>
              <span class="row-title">GitHub</span>
              <span class="row-detail">{links.github.replace(/^https?:\/\/(www\.)?/, '')}</span>
            </span>
          </a>
        </li>
      )}
      {links.resume && (
        <li>
          <a class="row" href={links.resume}>
            <Icon name="resume" size={22} />
            <span>
              <span class="row-title">Résumé</span>
              <span class="row-detail">PDF</span>
            </span>
          </a>
        </li>
      )}
    </ul>
    <p class="status" role="status" aria-live="polite"></p>
  </div>
</dialog>

<script>
  const sheet = document.getElementById('contact-sheet') as HTMLDialogElement | null;
  if (sheet) {
    // Safari doesn't focus a link on click, so the dialog's own focus return can land on <body>.
    // Remember the opener and focus it explicitly when the sheet closes.
    let opener: HTMLElement | null = null;
    document.querySelectorAll<HTMLElement>('[data-open-contact]').forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        opener = link;
        sheet.showModal();
      });
    });
    sheet.addEventListener('close', () => opener?.focus());
    // A click on the dialog element itself is a click on the backdrop: the panel fills the rest.
    sheet.addEventListener('click', (event) => {
      if (event.target === sheet) sheet.close();
    });
    sheet.querySelector('[data-close]')?.addEventListener('click', () => sheet.close());

    const status = sheet.querySelector('.status');
    sheet.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copy ?? '');
          if (status) status.textContent = 'Email address copied';
        } catch {
          if (status) status.textContent = `Copy failed. The address is ${button.dataset.copy}`;
        }
      });
    });
  }
</script>

<style>
  .sheet {
    width: 100%;
    max-width: 100%;
    margin: auto 0 0;
    padding: 0;
    color: var(--text);
    background: var(--bg-elevated);
    border: 0;
    border-radius: var(--radius-card) var(--radius-card) 0 0;
  }

  /* ::backdrop doesn't reliably inherit custom properties, so the scrim colour is literal here. */
  .sheet::backdrop {
    background: rgb(0 0 0 / 65%);
  }

  @media (min-width: 768px) {
    .sheet {
      width: 400px;
      margin: auto;
      border-radius: var(--radius-card);
      box-shadow: var(--shadow-strong);
    }
  }

  .panel {
    padding: var(--space-2) var(--space-4) calc(var(--space-4) + env(safe-area-inset-bottom, 0px));
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    border-bottom: 1px solid var(--separator);
  }

  h2 {
    margin: 0;
    font-size: var(--fs-16);
    line-height: var(--lh-16);
    font-weight: var(--weight-bold);
  }

  .close,
  .copy {
    display: flex;
    padding: var(--space-2);
    background: none;
    border: 0;
    border-radius: var(--radius-button);
    cursor: pointer;
  }

  .close:hover,
  .copy:hover {
    background: var(--hover-overlay);
  }

  ul {
    margin: 0;
    padding: var(--space-2) 0 0;
    list-style: none;
  }

  .row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 56px;
    padding: var(--space-2);
    color: var(--text);
    text-decoration: none;
    border-radius: var(--radius-button);
  }

  a.row:hover,
  .row-main:hover {
    background: var(--hover-overlay);
  }

  .row-main {
    flex: 1;
    color: inherit;
    text-decoration: none;
  }

  .row-title,
  .row-detail {
    display: block;
  }

  .row-title {
    font-weight: var(--weight-semibold);
  }

  .row-detail {
    color: var(--text-secondary);
    overflow-wrap: anywhere;
  }

  .status {
    min-height: var(--lh-12);
    margin: var(--space-2) 0 0;
    color: var(--text-secondary);
    font-size: var(--fs-12);
    line-height: var(--lh-12);
  }
</style>
