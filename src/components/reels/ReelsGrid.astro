---
import Icon from '../Icon.astro';
import type { Reel } from '../../lib/content-schema';
import TypeTile from '../post/TypeTile.astro';
import { posterSources } from '../../lib/reels';

interface Props {
  reels: { id: string; data: Reel }[];
  /** When this grid is the page's visible panel (/reels/): its first row is the largest paint. */
  eager?: boolean;
}

const { reels, eager = false } = Astro.props;
---

<ul class="reels-grid" role="list">
  {reels.map(({ id, data }, i) => (
    <li class="reel">
      <a
        class="reel-link"
        href={`/reels/${id}/`}
        data-reel={id}
        aria-label={`Reel: ${data.title}`}
        style={`--vt-name: reel-${id}`}
      >
        {data.poster ? (
          <img
            src={data.poster}
            {...posterSources(data.poster, 540)}
            alt=""
            width="540"
            height="960"
            loading={eager && i < 3 ? 'eager' : 'lazy'}
            fetchpriority={eager && i === 0 ? 'high' : 'auto'}
            decoding="async"
          />
        ) : (
          <TypeTile headline={data.title} tone={((i % 3) + 1) as 1 | 2 | 3} />
        )}
        <span class="badge" aria-hidden="true">
          <Icon name="reels" filled size={20} />
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .reels-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .reel {
    aspect-ratio: 9 / 16;
    overflow: hidden;
    background: var(--story-end);
  }

  .reel-link {
    position: relative;
    display: block;
    height: 100%;
  }

  .reel-link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .reel-link::after {
    content: '';
    position: absolute;
    inset: 0;
    transition: background-color 0.1s cubic-bezier(0.17, 0.17, 0, 1);
  }

  @media (hover: hover) {
    .reel-link:hover::after {
      background: rgb(0 0 0 / 30%);
    }
  }

  .reel-link:focus-visible {
    outline: none;
  }

  .reel-link:focus-visible::after {
    box-shadow: var(--focus-media);
  }

  .badge {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    z-index: 1;
    color: #ffffff;
    filter: drop-shadow(0 0 2px rgb(0 0 0 / 50%));
  }

  @media (min-width: 768px) {
    .reels-grid {
      gap: 4px;
    }
  }
</style>
