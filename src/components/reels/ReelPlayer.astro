---
import Icon from '../Icon.astro';
import type { Reel } from '../../lib/content-schema';

interface Props {
  reels: { id: string; data: Reel }[];
}

const playable = Astro.props.reels.filter((r) => r.data.video);
---

<dialog data-motion="fade" id="reel-player" class="reel-player" aria-label="Reels">
  <button class="reel-close" type="button" aria-label="Close">
    <Icon name="close" size={28} />
  </button>
  <button class="reel-prev" type="button" aria-label="Previous reel">
    <Icon name="back" size={20} />
  </button>
  <figure class="reel-stage">
    <video
      class="reel-video"
      playsinline
      muted
      loop
      preload="none"
      aria-describedby="reel-description"
    ></video>
    <button class="reel-toggle" type="button" aria-label="Pause" autofocus>
      <Icon name="pause" filled class="icon-pause" size={22} />
      <Icon name="play" filled class="icon-play" size={22} />
    </button>
    <figcaption>
      <p class="reel-title"></p>
      <p class="reel-description" id="reel-description"></p>
    </figcaption>
  </figure>
  <button class="reel-next" type="button" aria-label="Next reel">
    <Icon name="forward" size={20} />
  </button>
</dialog>

<script
  type="application/json"
  id="reel-data"
  set:html={JSON.stringify(
    playable.map(({ id, data }) => ({
      id,
      title: data.title,
      description: data.description ?? data.title,
      video: data.video,
      poster: data.poster,
    })),
  )}
/>
<script>
  import { initReelPlayer } from '../../scripts/reel-player';

  initReelPlayer();
</script>

<style>
  .reel-player {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    color: #ffffff;
    background: #000000;
    border: 0;
  }

  .reel-player[open] {
    display: grid;
    place-items: center;
  }

  .reel-player::backdrop {
    background: #000000;
  }

  /* Phones: the reel fills the screen (object-fit crops the edges); desktop: a 9:16 card. */
  .reel-stage {
    position: relative;
    width: 100%;
    height: 100%;
    margin: 0;
  }

  .reel-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #0c1014;
  }

  .reel-toggle,
  .reel-close {
    position: absolute;
    z-index: 2;
    display: flex;
    padding: var(--space-2);
    color: #ffffff;
    background: rgb(0 0 0 / 35%);
    border: 0;
    border-radius: 50%;
    cursor: pointer;
  }

  .reel-toggle {
    top: calc(var(--space-4) + env(safe-area-inset-top, 0px));
    right: var(--space-4);
  }

  .reel-close {
    position: fixed;
    top: calc(var(--space-4) + env(safe-area-inset-top, 0px));
    left: var(--space-4);
    background: rgb(0 0 0 / 35%);
  }

  .reel-toggle :global(.icon-play),
  .reel-toggle[aria-label='Play'] :global(.icon-pause) {
    display: none;
  }

  .reel-toggle[aria-label='Play'] :global(.icon-play) {
    display: block;
  }

  figcaption {
    position: absolute;
    inset: auto 0 0;
    padding: var(--space-8) var(--space-4) calc(var(--space-6) + env(safe-area-inset-bottom, 0px));
    background: linear-gradient(transparent, rgb(0 0 0 / 55%));
  }

  .reel-title {
    margin: 0;
    font-weight: var(--weight-semibold);
  }

  .reel-description {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .reel-prev,
  .reel-next {
    display: none;
  }

  .reel-close:focus-visible,
  .reel-toggle:focus-visible,
  .reel-prev:focus-visible,
  .reel-next:focus-visible {
    outline-color: #ffffff;
  }

  @media (min-width: 768px) {
    .reel-player,
    .reel-player::backdrop {
      background: #1a1a1a;
    }

    .reel-stage {
      width: auto;
      height: calc(100dvh - 32px);
      aspect-ratio: 9 / 16;
      overflow: hidden;
      border-radius: 8px;
    }

    .reel-close {
      right: var(--space-4);
      left: auto;
      background: none;
    }

    .reel-prev,
    .reel-next {
      position: fixed;
      z-index: 2;
      top: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      padding: 0;
      color: #0c1014;
      background: rgb(255 255 255 / 85%);
      border: 0;
      border-radius: 50%;
      transform: translateY(-50%);
      cursor: pointer;
    }

    .reel-prev {
      left: var(--space-6);
    }

    .reel-next {
      right: var(--space-6);
    }
  }
</style>
