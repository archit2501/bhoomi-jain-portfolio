---
import Icon from '../Icon.astro';
import type { Post } from '../../lib/content-schema';
import { loadPostArt } from '../../lib/content';
import Media from '../Media.astro';
import Cover from '../covers/Cover.astro';

interface Props {
  post: { id: string; data: Post };
  /** The first row loads eagerly; it holds the page's largest paint. */
  eager?: boolean;
  /** On /saved/: drawn hidden, and shown once the visitor's saved list says so. */
  savedId?: string;
}

const { post, eager = false, savedId } = Astro.props;
const { media, pinned, title } = post.data;
const first = media[0];
const label = [
  pinned && 'Pinned post.',
  media.length > 1 && `Carousel, ${media.length} slides.`,
  title,
]
  .filter(Boolean)
  .join(' ');
const art = (await loadPostArt()).get(post.id);
const field = art && art.field !== 'photo' ? art.field : undefined;
---

<li class="tile" data-saved-id={savedId} hidden={savedId !== undefined}>
  <a
    href={`/p/${post.id}/`}
    aria-label={label}
    data-post={post.id}
    data-field={field}
    style={`--vt-name: post-${post.id}`}
  >
    {first.type === 'image' ? (
      <Media
        src={first.src}
        alt=""
        widths={[240, 360, 480, 720]}
        sizes="(min-width: 768px) 296px, 33vw"
        width={360}
        height={480}
        priority={eager}
        fill
      />
    ) : (
      art &&
      art.cover.layout !== 'photo' && (
        <Cover
          cover={art.cover}
          mark={art.mark}
          reserve={(Number(Boolean(pinned)) + Number(media.length > 1)) * 24}
        />
      )
    )}
    <span class="badges" aria-hidden="true">
      {pinned && <Icon name="pin" filled size={20} />}
      {media.length > 1 && <Icon name="carousel" filled size={20} />}
    </span>
  </a>
</li>

<style>
  .tile a {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    /* A printed field (data-field) brings its own colours; a photo sits on the placeholder. */
    color: var(--f-fg, inherit);
    text-decoration: none;
    background-color: var(--f-bg, var(--bg-secondary));
  }

  .tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tile a::after {
    content: '';
    position: absolute;
    inset: 0;
    background: transparent;
    transition: background-color 0.1s cubic-bezier(0.17, 0.17, 0, 1);
  }

  @media (hover: hover) {
    .tile a:hover::after {
      background: rgb(0 0 0 / 30%);
    }
  }

  /* The ring is drawn on the overlay, above the photo or tile, in two tones (tokens.css). */
  .tile a:focus-visible {
    outline: none;
  }

  .tile a:focus-visible::after {
    box-shadow: var(--focus-media);
  }

  .badges {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    z-index: 1;
    display: flex;
    gap: var(--space-1);
    color: #ffffff;
    filter: drop-shadow(0 0 2px rgb(0 0 0 / 50%));
  }

  /* On a printed field the badges take the field's ink, like the type. */
  .tile a[data-field] .badges {
    color: var(--f-meta);
    filter: none;
  }
</style>
