---
import Icon from '../Icon.astro';
import { Picture } from 'astro:assets';
import type { Post } from '../../lib/content-schema';
import { mediaImage } from '../../lib/media';
import { tileTone } from '../../lib/site';
import TypeTile from '../post/TypeTile.astro';

interface Props {
  post: { id: string; data: Post };
  /** The first row loads eagerly; it holds the page's largest paint. */
  eager?: boolean;
}

const { post, eager = false } = Astro.props;
const { media, pinned, title, order } = post.data;
const first = media[0];
const label = [
  pinned && 'Pinned post.',
  media.length > 1 && `Carousel, ${media.length} slides.`,
  title,
]
  .filter(Boolean)
  .join(' ');
const tone = tileTone(order);
---

<li class="tile">
  <a href={`/p/${post.id}/`} aria-label={label} data-post={post.id}>
    {first.type === 'image' ? (
      <Picture
        src={mediaImage(first.src)}
        alt=""
        formats={['avif', 'webp']}
        widths={[240, 360, 480, 720]}
        sizes="(min-width: 768px) 296px, 33vw"
        width={360}
        height={480}
        fit="cover"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    ) : (
      <TypeTile headline={first.headline} detail={first.detail} tone={tone} />
    )}
    <span class="badges" aria-hidden="true">
      {pinned && <Icon name="pin" filled size={20} />}
      {media.length > 1 && <Icon name="carousel" filled size={20} />}
    </span>
  </a>
</li>

<style>
  .tile a {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    background: var(--bg-secondary);
  }

  .tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tile a::after {
    content: '';
    position: absolute;
    inset: 0;
    background: transparent;
    transition: background-color 0.1s cubic-bezier(0.17, 0.17, 0, 1);
  }

  .tile a:hover::after {
    background: rgb(0 0 0 / 30%);
  }

  /* The ring is drawn on the overlay, above the photo or tile, in two tones (tokens.css). */
  .tile a:focus-visible {
    outline: none;
  }

  .tile a:focus-visible::after {
    box-shadow: var(--focus-media);
  }

  .badges {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    z-index: 1;
    display: flex;
    gap: var(--space-1);
    color: #ffffff;
    filter: drop-shadow(0 0 2px rgb(0 0 0 / 50%));
  }
</style>
