---
import type { Profile } from '../../lib/content-schema';

interface Props {
  links: Profile['links'];
}

const { links } = Astro.props;
---

<!-- Real actions in the slots Instagram uses for Follow and Message. Nothing here needs an account. -->
<div class="actions">
  <a class="btn primary" href="#contact" data-open-contact>
    Contact
  </a>
  <a class="btn secondary" href={links.linkedin} target="_blank" rel="noopener noreferrer">
    LinkedIn
  </a>
  {links.resume && (
    <a class="btn secondary" href={links.resume}>
      Resume
    </a>
  )}
</div>

<style>
  .actions {
    display: flex;
    gap: 6px;
  }

  .btn {
    display: inline-flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    height: 32px;
    padding: 0 var(--space-4);
    font-size: var(--fs-14);
    line-height: var(--lh-14);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    white-space: nowrap;
    border-radius: var(--radius-button);
    transition: background-color 0.1s cubic-bezier(0.17, 0.17, 0, 1);
  }

  .primary {
    color: var(--on-accent);
    background: var(--accent);
  }

  .primary:hover {
    background: var(--accent-hover);
  }

  .secondary {
    color: var(--button-secondary-text);
    background: var(--button-secondary);
  }

  .secondary:hover {
    background: var(--button-secondary-hover);
  }

  @media (min-width: 768px) {
    .actions {
      gap: var(--space-2);
    }

    .btn {
      flex: none;
    }
  }
</style>
