---
import type { Profile } from '../../lib/content-schema';

interface Props {
  links: Profile['links'];
}

const { links } = Astro.props;
---

<!--
  Real actions in the slots Instagram uses for Follow and Message: Message opens her inbox,
  then the résumé (or email until there is one) and LinkedIn. Nothing here needs an account.
-->
<div class="actions">
  <a class="btn primary" href="/direct/">
    Message
  </a>
  {links.resume ? (
    <a class="btn secondary" href={links.resume}>
      Résumé
    </a>
  ) : (
    links.email && (
      <a class="btn secondary" href={`mailto:${links.email}`}>
        Email
      </a>
    )
  )}
  <a class="btn secondary" href={links.linkedin} target="_blank" rel="noopener noreferrer">
    LinkedIn
  </a>
</div>

<style>
  .actions {
    display: flex;
    gap: 6px;
  }

  .btn {
    display: inline-flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    height: 32px;
    padding: 0 var(--space-4);
    font-size: var(--fs-14);
    line-height: var(--lh-14);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    white-space: nowrap;
    border-radius: var(--radius-button);
    transition: background-color 0.1s cubic-bezier(0.17, 0.17, 0, 1);
  }

  .primary {
    color: var(--on-accent);
    background: var(--accent);
  }

  @media (hover: hover) {
    .primary:hover {
      background: var(--accent-hover);
    }
  }

  .secondary {
    color: var(--button-secondary-text);
    background: var(--button-secondary);
  }

  @media (hover: hover) {
    .secondary:hover {
      background: var(--button-secondary-hover);
    }
  }

  @media (min-width: 768px) {
    .actions {
      gap: var(--space-2);
    }

    .btn {
      flex: none;
    }
  }
</style>
