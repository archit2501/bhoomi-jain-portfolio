---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadSiteContent } from '../../lib/content';
import { posterSources } from '../../lib/reels';
import PostModal from '../post/PostModal.astro';
import ShareSheet from '../share/ShareSheet.astro';
import StoryViewer from '../story/StoryViewer.astro';
import Highlights from './Highlights.astro';
import ProfileHeader from './ProfileHeader.astro';
import ProfileTabs, { type ProfileTab } from './ProfileTabs.astro';

interface Props {
  tab: ProfileTab;
}

const { tab } = Astro.props;
const { profile, figures, highlights, posts, reels } = await loadSiteContent();
// `inRow` defaults to true; only an explicit false (the intro) leaves the row.
const intro = highlights.find((h) => h.data.inRow === false);
---

<!-- "/", "/reels/" and "/tagged/" are one profile with a different tab selected, as on Instagram. -->
<BaseLayout
  title={tab === 'reels' ? 'Reels' : tab === 'tagged' ? 'Tagged' : undefined}
  current={tab === 'reels' ? 'reels' : 'profile'}
  preload={
    tab === 'reels' && reels[0]?.data.poster
      ? { href: reels[0].data.poster, ...posterSources(reels[0].data.poster, 540) }
      : undefined
  }
>
  <ProfileHeader profile={profile} figures={figures} intro={intro} />
  <Highlights highlights={highlights.filter((h) => h.data.inRow !== false)} />
  <ProfileTabs
    selected={tab}
    posts={posts}
    reels={reels}
    firstName={profile.displayName.split(/\s+/)[0]}
  />
  <PostModal posts={posts} profile={profile} />
  <StoryViewer highlights={highlights} profile={profile} />
  <ShareSheet profile={profile} />
</BaseLayout>
