---
/**
 * One post in the home feed, as Instagram shows it: her name and the date, the first slide,
 * the action row (a real like, the comments, the link), the likes line, the caption cut at two
 * lines with "more", and a way to the comments. src/scripts/feed.ts brings it to life.
 */
import type { Lens } from '../../lib/feed';
import type { Post, Profile } from '../../lib/content-schema';
import { postDate } from '../../lib/post-date';
import { plainText } from '../../lib/markdown';
import Avatar from '../Avatar.astro';
import Icon from '../Icon.astro';
import Media from '../Media.astro';
import ActionRow from '../post/ActionRow.astro';
import Cover from '../covers/Cover.astro';
import { loadPostArt } from '../../lib/content';

interface Props {
  post: { id: string; data: Post; body: string };
  profile: Profile;
  lenses: Lens[];
  /** The first card holds the page's largest paint. */
  eager?: boolean;
}

const { post, profile, lenses, eager = false } = Astro.props;
const { id, data, body } = post;
const first = data.media[0];
const when = postDate(data.date, data.dateLabel);
const initials = profile.displayName
  .split(/\s+/)
  .map((part) => part[0])
  .join('')
  .slice(0, 2);
const caption = plainText(body.trim());
const art = (await loadPostArt()).get(id);
const field = art && art.field !== 'photo' ? art.field : undefined;
---

<article
  class="feed-card"
  aria-labelledby={`feed-${id}`}
  data-lenses={lenses.join(' ')}
  data-href={`/p/${id}/`}
>
  <header class="card-head">
    <a class="avatar-link" href="/" tabindex="-1" aria-hidden="true">
      <Avatar size={32} src={profile.avatar.src} alt="" initials={initials} />
    </a>
    <div class="who">
      <p class="line">
        <a class="username" href="/">
          {profile.username}
        </a>
        {when && (
          <span class="when">
            <span aria-hidden="true"> · </span>
            {when.datetime ? <time datetime={when.datetime}>{when.text}</time> : when.text}
          </span>
        )}
      </p>
      {data.org && <p class="org">{data.org}</p>}
    </div>
  </header>

  <!-- Not a link: a double-tap likes, as on Instagram. The title and comments lead to the post. -->
  <div class="card-media" data-like-media data-field={first.type === 'image' ? undefined : field}>
    {first.type === 'image' ? (
      <Media
        src={first.src}
        alt={first.alt}
        widths={[360, 470, 720, 940]}
        sizes="(min-width: 470px) 470px, 100vw"
        width={470}
        height={588}
        priority={eager}
        fill
      />
    ) : (
      art &&
      art.cover.layout !== 'photo' && (
        <Cover cover={art.cover} mark={art.mark} reserve={data.media.length > 1 ? 28 : 0} />
      )
    )}
    {data.media.length > 1 && (
      <span class="badge" aria-hidden="true">
        <Icon name="carousel" filled size={20} />
      </span>
    )}
    <span class="burst" aria-hidden="true">
      <Icon name="heart" filled size={96} />
    </span>
  </div>

  <ActionRow id={id} />

  <div class="card-body">
    <h2 id={`feed-${id}`} class="title">
      <a href={`/p/${id}/`}>{data.title}</a>
    </h2>
    <p class="caption" data-caption>
      <a class="username" href="/">
        {profile.username}
      </a>{' '}
      {caption}
    </p>
    <button type="button" class="more" data-more hidden>
      more
    </button>
    <a class="comments-link" href={`/p/${id}/`}>
      View comments
    </a>
  </div>
</article>

<style>
  /*
   * Cards below the fold skip layout and paint until they near the screen. Only the height has
   * a placeholder: the width always comes from the column.
   */
  .feed-card {
    content-visibility: auto;
    contain-intrinsic-block-size: auto 760px;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--separator);
  }

  .card-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
  }

  .avatar-link {
    display: flex;
  }

  .who p {
    margin: 0;
    font-size: var(--fs-14);
    line-height: var(--lh-14);
  }

  .username {
    color: inherit;
    font-weight: var(--weight-semibold);
    text-decoration: none;
  }

  .when,
  .org {
    color: var(--text-secondary);
  }

  .who .org {
    font-size: var(--fs-12);
    line-height: var(--lh-12);
  }

  .card-media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    color: var(--f-fg, inherit);
    background-color: var(--f-bg, var(--media-placeholder));
  }

  .badge {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    color: #ffffff;
    filter: drop-shadow(0 0 2px rgb(0 0 0 / 50%));
  }

  .card-media[data-field] .badge {
    color: var(--f-meta);
    filter: none;
  }

  .burst {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    color: #ffffff;
    filter: drop-shadow(0 0 12px rgb(0 0 0 / 35%));
    opacity: 0;
    translate: -50% -50%;
    pointer-events: none;
  }

  .feed-card :global(.action-row) {
    padding: var(--space-1) var(--space-2) 0;
  }

  .card-body {
    padding: 0 var(--space-4);
    font-size: var(--fs-14);
    line-height: var(--lh-14);
  }

  .title {
    margin: var(--space-1) 0;
    font-size: var(--fs-14);
    line-height: var(--lh-14);
    font-weight: var(--weight-semibold);
  }

  .title a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: inherit;
    text-decoration: none;
  }

  .caption {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow-wrap: anywhere;
  }

  .caption.open {
    display: block;
  }

  .more {
    min-height: 24px;
    padding: 0;
    font: inherit;
    color: var(--text-secondary);
    background: none;
    border: 0;
    cursor: pointer;
  }

  .more[hidden] {
    display: none;
  }

  .comments-link {
    display: flex;
    align-items: center;
    width: fit-content;
    min-height: 24px;
    color: var(--text-secondary);
    text-decoration: none;
  }

  @media (min-width: 470px) {
    .feed-card {
      border: 1px solid var(--separator);
      border-radius: var(--radius-button);
      overflow: hidden;
    }
  }
</style>
