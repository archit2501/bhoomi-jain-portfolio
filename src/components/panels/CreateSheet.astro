---
import { loadSiteContent } from '../../lib/content';
import Icon from '../Icon.astro';

const { dmThreads } = await loadSiteContent();
---

<!--
  Instagram's Create (+). There's nothing for a visitor to create here, so it starts a
  conversation instead: one row per starter thread in Messages.
-->
<dialog id="create-sheet" class="create-sheet" aria-labelledby="create-title">
  <div class="sheet-inner">
    <header class="sheet-head">
      <h2 id="create-title">Start a conversation</h2>
      <button class="close" type="button" data-close aria-label="Close">
        <Icon name="close" size={24} />
      </button>
    </header>
    <ul role="list">
      {dmThreads.map(({ id, data }) => (
        <li>
          <a class="row" href={`/direct/${id}/`}>
            <Icon name={data.ai ? 'insights' : 'messages'} size={24} />
            <span class="row-text">
              <span class="row-title">{data.label}</span>
              <span class="row-preview">{data.opener}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</dialog>

<style>
  .create-sheet {
    width: min(400px, 100vw);
    max-width: none;
    margin: auto auto 0;
    padding: 0;
    color: var(--text);
    background: var(--bg-elevated);
    border: 0;
    border-radius: var(--radius-sheet) var(--radius-sheet) 0 0;
    box-shadow: var(--shadow-strong);
    transform: translateY(100%);
    transition:
      transform var(--dur-sheet-out) var(--ease-ig),
      display var(--dur-sheet-out) allow-discrete,
      overlay var(--dur-sheet-out) allow-discrete;
  }

  /* While it animates out it stays in the top layer: let clicks through to the page. */
  .create-sheet:not([open]),
  .create-sheet:not([open])::backdrop {
    pointer-events: none;
  }

  .create-sheet[open] {
    transform: none;
    transition-duration: var(--dur-sheet-in);
    transition-timing-function: var(--ease-sheet);
  }

  @starting-style {
    .create-sheet[open] {
      transform: translateY(100%);
    }
  }

  .create-sheet::backdrop {
    background: var(--scrim);
  }

  @media (min-width: 768px) {
    .create-sheet {
      margin: auto;
      border-radius: var(--radius-dialog);
      transform: scale(var(--modal-from-scale));
      opacity: 0;
      transition:
        transform var(--dur-modal) var(--ease-out),
        opacity var(--dur-modal) var(--ease-out),
        display var(--dur-modal) allow-discrete,
        overlay var(--dur-modal) allow-discrete;
    }

    .create-sheet[open] {
      transform: none;
      opacity: 1;
      transition-duration: var(--dur-modal);
      transition-timing-function: var(--ease-out);
    }

    @starting-style {
      .create-sheet[open] {
        transform: scale(var(--modal-from-scale));
        opacity: 0;
      }
    }
  }

  .sheet-inner {
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }

  .sheet-head {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    padding: var(--space-3) var(--space-2) var(--space-3) var(--space-6);
    border-bottom: 1px solid var(--separator);
  }

  h2 {
    margin: 0;
    font-size: var(--fs-16);
    line-height: var(--lh-16);
    font-weight: var(--weight-bold);
  }

  .close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--text);
    background: none;
    border: 0;
    border-radius: var(--radius-button);
    cursor: pointer;
  }

  ul {
    margin: 0;
    padding: var(--space-2) 0;
    list-style: none;
  }

  .row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 60px;
    padding: var(--space-2) var(--space-6);
    color: inherit;
    text-decoration: none;
  }

  @media (hover: hover) {
    .row:hover {
      background: var(--hover-overlay);
    }
  }

  .row-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .row-title {
    font-weight: var(--weight-semibold);
  }

  .row-preview {
    overflow: hidden;
    color: var(--text-secondary);
    font-size: var(--fs-14);
    line-height: var(--lh-14);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  @media (prefers-reduced-motion: reduce) {
    .create-sheet,
    .create-sheet[open] {
      transform: none;
      transition-property: opacity, display, overlay;
    }

    @starting-style {
      .create-sheet[open] {
        transform: none;
      }
    }
  }
</style>
