---
import type { DiagramEdge, DiagramNode } from '../../lib/diagram';
import { describeDiagram, layoutDiagram } from '../../lib/diagram';

interface Props {
  title: string;
  nodes: DiagramNode[];
  edges: DiagramEdge[];
  /** Unique within the page, for the arrowhead marker's id. */
  id: string;
}

const { title, nodes, edges, id } = Astro.props;
const { width, height, boxes, arrows } = layoutDiagram(nodes, edges);
const marker = `arrow-${id}`;
const LINE = 18;
---

<!-- How the system fits together, drawn at build time from what the résumé says it is. -->
<figure class="diagram-slide">
  <figcaption class="diagram-title">{title}</figcaption>
  <svg
    viewBox={`0 0 ${width} ${height}`}
    role="img"
    aria-label={`${title}: ${describeDiagram(nodes, edges)}`}
    preserveAspectRatio="xMidYMid meet"
  >
    <defs>
      <marker
        id={marker}
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path d="M0 0 L10 5 L0 10 z" class="arrowhead"></path>
      </marker>
    </defs>
    {arrows.map((a) => (
      <g class:list={['edge', `layer-${a.layer % 4}`]}>
        <line x1={a.x1} y1={a.y1 + 4} x2={a.x2} y2={a.y2 - 6} marker-end={`url(#${marker})`} />
        <circle class="packet" cx={(a.x1 + a.x2) / 2} cy={(a.y1 + a.y2) / 2} r="4.5" />
        {a.label && (
          <g class="edge-tag">
            <rect
              x={a.labelX - 6}
              y={a.labelY - 12}
              width={a.label.length * 6.7 + 12}
              height="17"
              rx="8.5"
            />
            <text x={a.labelX} y={a.labelY} class="edge-label">
              {a.label}
            </text>
          </g>
        )}
      </g>
    ))}
    {boxes.map((b) => {
      const lines = b.label.length + b.detail.length;
      const top = b.y + b.height / 2 - ((lines - 1) * LINE) / 2 + 5;
      return (
        <g class:list={['node', `layer-${b.layer % 4}`]}>
          <rect x={b.x} y={b.y} width={b.width} height={b.height} rx="14" />
          <rect class="bar" x={b.x} y={b.y + 14} width="5" height={b.height - 28} rx="2.5" />
          {b.label.map((line, i) => (
            <text x={b.x + b.width / 2} y={top + i * LINE} class="node-label">
              {line}
            </text>
          ))}
          {b.detail.map((line, i) => (
            <text x={b.x + b.width / 2} y={top + (b.label.length + i) * LINE} class="node-detail">
              {line}
            </text>
          ))}
        </g>
      );
    })}
  </svg>
</figure>

<style>
  /* A blueprint on the deep field (the slide sets data-field="deep"): a dot grid, each layer
     marked in her ring's order (lime, emerald, cyan, sky) as data flows down. */
  .diagram-slide {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 7% 6% 4%;
    background: radial-gradient(circle, rgb(255 255 255 / 11%) 0 1px, transparent 1.6px) 0 0 / 22px
      22px;
    font-family: var(--font-display);
    container-type: inline-size;
  }

  .diagram-title {
    padding-bottom: 2.4cqi;
    border-bottom: max(1px, 0.4cqi) solid rgb(255 255 255 / 22%);
    font-size: clamp(15px, 6.4cqi, 30px);
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: -0.025em;
  }

  svg {
    flex: 1;
    width: 100%;
    min-height: 0;
  }

  .node {
    --layer: var(--field-lime);
  }

  .layer-1 {
    --layer: var(--field-emerald);
  }

  .layer-2 {
    --layer: var(--field-cyan);
  }

  .layer-3 {
    --layer: var(--field-sky);
  }

  .edge {
    --layer: var(--field-emerald);
  }

  .edge.layer-2 {
    --layer: var(--field-cyan);
  }

  .edge.layer-3 {
    --layer: var(--field-sky);
  }

  .node rect {
    fill: rgb(255 255 255 / 5%);
    stroke: rgb(255 255 255 / 20%);
    stroke-width: 1.2;
  }

  .node .bar {
    fill: var(--layer);
    stroke: none;
  }

  .node-label,
  .node-detail,
  .edge-label {
    fill: currentColor;
    font-family: var(--font-display);
    text-anchor: middle;
  }

  .node-label {
    font-size: 15px;
    font-weight: 700;
  }

  .node-detail {
    font-family: var(--font-mono);
    font-size: 11.5px;
    fill: var(--field-deep-meta);
  }

  .edge line {
    stroke: var(--layer);
    stroke-width: 2;
  }

  .packet {
    fill: var(--layer);
  }

  .arrowhead {
    fill: var(--field-deep-meta);
  }

  .edge-tag rect {
    fill: var(--field-deep);
    stroke: var(--layer);
    stroke-width: 1.2;
  }

  .edge-label {
    font-family: var(--font-mono);
    font-size: 11px;
    text-anchor: start;
    fill: var(--field-deep-fg);
  }
</style>
