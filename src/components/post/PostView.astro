---
import { getEntry, render } from 'astro:content';
import EmptyState from '../EmptyState.astro';
import Icon from '../Icon.astro';
import type { Post, Profile } from '../../lib/content-schema';
import { postDate } from '../../lib/post-date';
import { tileTone } from '../../lib/site';
import Avatar from '../Avatar.astro';
import Media from '../Media.astro';
import CodeSlide from './CodeSlide.astro';
import DiagramSlide from './DiagramSlide.astro';
import TypeTile from './TypeTile.astro';
import ActionRow from './ActionRow.astro';
import CommentForm from './CommentForm.astro';

interface Props {
  post: { id: string; data: Post; body: string };
  profile: Profile;
  /** "page" for /p/<slug>/, "modal" inside the desktop pop-up. */
  variant: 'page' | 'modal';
}

const { post, profile, variant } = Astro.props;
const { id } = post;
const { title, media, location, org, date, dateLabel, order, testimonials, tldr } = post.data;
// The caption is markdown (lists, emphasis, links), rendered by Astro like any content page.
const entry = await getEntry('posts', id);
const Caption = entry ? (await render(entry)).Content : undefined;
const when = postDate(date, dateLabel);
const tone = tileTone(order);
const initialsOf = (name: string) =>
  name
    .split(/\s+/)
    .map((part) => part[0])
    .join('')
    .slice(0, 2);
const initials = initialsOf(profile.displayName);
const Heading = variant === 'page' ? 'h1' : 'h2';
---

<article class:list={['post-view', variant]} data-slug={id} aria-labelledby={`post-title-${id}`}>
  <Heading id={`post-title-${id}`} class="visually-hidden">
    {title}
  </Heading>

  <header class="head">
    <Avatar size={32} src={profile.avatar.src} alt="" initials={initials} />
    <div>
      <p class="username">{profile.username}</p>
      {location && <p class="place">{location}</p>}
    </div>
  </header>

  <div
    class="media"
    data-like-media
    style={variant === 'page' ? `--vt-name: post-${id}` : undefined}
  >
    <div
      class="track"
      tabindex={media.length > 1 ? 0 : undefined}
      aria-label={media.length > 1 ? `${media.length} slides` : undefined}
    >
      {media.map((item, i) => (
        <div
          class="slide"
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 1} of ${media.length}`}
        >
          {item.type === 'image' && (
            <>
              <Media
                src={item.src}
                alt={item.alt}
                widths={[480, 720, 1080]}
                sizes="(min-width: 768px) 600px, 100vw"
                priority={i === 0}
                fill
              />
              {item.tags.length > 0 && (
                <>
                  <ul class="tags" role="list" aria-label="Tagged in this screen">
                    {item.tags.map((tag) => (
                      <li style={`left: ${tag.x}%; top: ${tag.y}%`}>
                        <a class="tag" href={`/explore/?q=${encodeURIComponent(tag.label)}`}>
                          {tag.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                  <button class="tags-toggle" type="button" aria-pressed="false">
                    <Icon name="tagged" size={16} />
                    <span class="visually-hidden">Show tags</span>
                  </button>
                </>
              )}
            </>
          )}
          {item.type === 'text' && (
            <TypeTile headline={item.headline} detail={item.detail} tone={tone} />
          )}
          {item.type === 'diagram' && (
            <DiagramSlide
              id={`${id}-${i}-${variant}`}
              title={item.title}
              nodes={item.nodes}
              edges={item.edges}
            />
          )}
          {item.type === 'code' && (
            <CodeSlide code={item.code} lang={item.lang} caption={item.caption} />
          )}
        </div>
      ))}
    </div>
    {media.length > 1 && (
      <>
        <button class="slide-nav prev" type="button" aria-label="Previous slide" hidden>
          <Icon name="back" size={18} />
        </button>
        <button class="slide-nav next" type="button" aria-label="Next slide">
          <Icon name="forward" size={18} />
        </button>
        <div class="dots" aria-hidden="true">
          {media.map((_, i) => (
            <span class:list={{ on: i === 0 }} />
          ))}
        </div>
        <p class="slide-status visually-hidden" aria-live="polite" />
      </>
    )}
    <span class="burst" aria-hidden="true">
      <Icon name="heart" filled size={96} />
    </span>
  </div>

  <div class="comments">
    <div class="comment">
      <Avatar size={32} src={profile.avatar.src} alt="" initials={initials} />
      <div>
        <div class="text">
          <strong>{profile.username}</strong>
          <div class="caption">{Caption ? <Caption /> : post.body.trim()}</div>
        </div>
        <p class="meta">{org}</p>
      </div>
    </div>
    {tldr && (
      <div class="comment pinned">
        <Avatar size={32} src={profile.avatar.src} alt="" initials={initials} />
        <div>
          <p class="text">
            <strong>{profile.username}</strong>
            <span class="caption">{tldr}</span>
          </p>
          <p class="meta">
            <Icon name="pin" filled size={12} />
            Pinned
          </p>
        </div>
      </div>
    )}
    {testimonials.map((t) => (
      <div class="comment">
        <Avatar size={32} alt="" initials={initialsOf(t.name)} />
        <div>
          <p class="text">
            <strong>{t.name}</strong>
            <span class="caption">{t.quote}</span>
          </p>
          <p class="meta">{[t.role, t.source].filter(Boolean).join(' · ')}</p>
        </div>
      </div>
    ))}
    <!-- Visitors' comments, approved by Bhoomi (src/scripts/comments.ts fills it). -->
    <ul class="comment-list" role="list" data-comment-list hidden></ul>
  </div>

  <ActionRow class="actions" id={id} when={when} />

  <div class="compose">
    <button class="open-comments" type="button" aria-haspopup="dialog" data-needs-js>
      Add a comment…
    </button>
    <CommentForm post={id} place="column" />
  </div>

  {variant === 'page' && (
    <dialog class="comments-sheet" data-motion="sheet" aria-labelledby={`comments-title-${id}`}>
      <header class="sheet-head">
        <h2 id={`comments-title-${id}`}>Comments</h2>
        <button class="sheet-close icon-button" type="button" aria-label="Close">
          <Icon name="close" size={22} />
        </button>
      </header>
      <div class="sheet-body">
        {tldr && (
          <div class="comment pinned">
            <Avatar size={32} src={profile.avatar.src} alt="" initials={initials} />
            <div>
              <p class="text">
                <strong>{profile.username}</strong>
                <span class="caption">{tldr}</span>
              </p>
              <p class="meta">
                <Icon name="pin" filled size={12} />
                Pinned
              </p>
            </div>
          </div>
        )}
        <ul class="comment-list" role="list" data-comment-list />
        <div class="comments-empty">
          <EmptyState icon="comment" title="No comments yet" level={3} compact>
            Start the conversation.
            <button slot="action" type="button" class="empty-action" data-focus-comment>
              Add a comment
            </button>
          </EmptyState>
        </div>
      </div>
      <CommentForm post={id} place="sheet" />
    </dialog>
  )}
</article>

<style>
  .post-view {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'head'
      'media'
      'actions'
      'comments'
      'compose';
    color: var(--text);
    background: var(--bg);
  }

  .modal {
    background: var(--bg-elevated);
  }

  .head {
    grid-area: head;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 60px;
    padding: 0 var(--space-4);
  }

  .head p,
  .comment p {
    margin: 0;
  }

  .username,
  .text strong {
    font-weight: var(--weight-semibold);
  }

  .place,
  .meta,
  .date {
    color: var(--text-secondary);
    font-size: var(--fs-12);
    line-height: var(--lh-12);
  }

  .media {
    grid-area: media;
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--story-end);
  }

  .track {
    display: flex;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  .track:focus-visible {
    outline-offset: -3px;
  }

  .slide {
    position: relative;
    flex: 0 0 100%;
    height: 100%;
    scroll-snap-align: start;
  }

  /* Tags on a screenshot, hidden until the tag button is pressed, as on Instagram photos. */
  .tags {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-fade-in) var(--ease-ig);
  }

  .slide:has(.tags-toggle[aria-pressed='true']) .tags {
    opacity: 1;
    pointer-events: auto;
  }

  .tags li {
    position: absolute;
    transform: translate(-50%, 6px);
  }

  .tag {
    position: relative;
    display: inline-block;
    padding: 6px 10px;
    color: #ffffff;
    font-size: var(--fs-12);
    line-height: var(--lh-12);
    font-weight: var(--weight-semibold);
    white-space: nowrap;
    text-decoration: none;
    background: rgb(0 0 0 / 82%);
    border-radius: 6px;
  }

  .tag::before {
    content: '';
    position: absolute;
    top: -5px;
    left: calc(50% - 5px);
    border: 5px solid transparent;
    border-top: 0;
    border-bottom-color: rgb(0 0 0 / 82%);
  }

  .tags-toggle {
    position: absolute;
    bottom: var(--space-3);
    left: var(--space-3);
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    color: #ffffff;
    background: rgb(0 0 0 / 72%);
    border: 0;
    border-radius: 50%;
    cursor: pointer;
  }

  .slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .slide-nav {
    position: absolute;
    top: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    padding: 0;
    color: #0c1014;
    background: rgb(255 255 255 / 85%);
    border: 0;
    border-radius: 50%;
    transform: translateY(-50%);
    cursor: pointer;
  }

  .prev {
    left: var(--space-3);
  }

  .next {
    right: var(--space-3);
  }

  .dots {
    position: absolute;
    bottom: var(--space-4);
    left: 50%;
    display: flex;
    gap: var(--space-1);
    transform: translateX(-50%);
  }

  .dots span {
    width: 6px;
    height: 6px;
    background: rgb(255 255 255 / 40%);
    border-radius: 50%;
  }

  .dots span.on {
    background: #ffffff;
  }

  /* The double-tap heart: a hidden template that src/scripts/like.ts copies to each tap point. */
  .burst {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    color: #ffffff;
    filter: drop-shadow(0 0 12px rgb(0 0 0 / 35%));
    opacity: 0;
    translate: -50% -50%;
    pointer-events: none;
  }

  .comments {
    grid-area: comments;
    display: grid;
    align-content: start;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-4) var(--space-4);
  }

  .comment {
    display: flex;
    gap: var(--space-3);
  }

  /* ---- visitors' comments ---- */
  .comment-list {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* On a phone the list lives in the sheet; the column shows her caption and pinned comment. */
  .comments .comment-list {
    display: none;
  }

  .comment-list :global(.visitor-comment) {
    display: flex;
    gap: var(--space-3);
  }

  .comment-list :global(.visitor-initials) {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    font-size: var(--fs-12);
    font-weight: var(--weight-semibold);
    color: var(--text);
    background: var(--bg-secondary);
    border-radius: 50%;
  }

  .comment-list :global(.visitor-text) {
    margin: 0;
    overflow-wrap: anywhere;
    white-space: pre-line;
  }

  .comment-list :global(.visitor-meta) {
    margin: var(--space-1) 0 0;
    font-size: var(--fs-12);
    line-height: var(--lh-12);
    color: var(--text-secondary);
  }

  .compose {
    grid-area: compose;
  }

  .open-comments {
    display: block;
    width: 100%;
    padding: var(--space-1) var(--space-4) var(--space-4);
    font: inherit;
    text-align: left;
    color: var(--text-secondary);
    background: none;
    border: 0;
    cursor: pointer;
  }

  @media (max-width: 767px) {
    .compose :global(.comment-form) {
      display: none;
    }
  }

  /* ---- the comments sheet (phones) ---- */
  .comments-sheet {
    width: 100%;
    max-width: 100%;
    max-height: 85dvh;
    margin: auto 0 0;
    padding: 0 0 env(safe-area-inset-bottom, 0px);
    color: var(--text);
    background: var(--bg-elevated);
    border: 0;
    border-radius: var(--radius-sheet) var(--radius-sheet) 0 0;
  }

  .comments-sheet[open] {
    display: flex;
    flex-direction: column;
  }

  /* ::backdrop doesn't reliably inherit custom properties, so the scrim colour is literal here. */
  .comments-sheet::backdrop {
    background: rgb(0 0 0 / 65%);
  }

  .sheet-head {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    min-height: 48px;
    border-bottom: 1px solid var(--separator);
  }

  .sheet-head h2 {
    margin: 0;
    font-size: var(--fs-16);
    font-weight: var(--weight-bold);
  }

  .sheet-close {
    position: absolute;
    right: var(--space-2);
    display: flex;
    padding: var(--space-2);
    color: var(--text);
    background: none;
    border: 0;
    border-radius: var(--radius-button);
    cursor: pointer;
  }

  .sheet-body {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    min-height: 120px;
    padding: var(--space-4);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .empty-action {
    min-height: 32px;
    padding: 0 var(--space-4);
    font: inherit;
    font-size: var(--fs-14);
    font-weight: var(--weight-semibold);
    color: var(--on-accent);
    background: var(--accent);
    border: 0;
    border-radius: var(--radius-button);
    cursor: pointer;
  }

  .sheet-body .comment-list:not(:empty) + .comments-empty {
    display: none;
  }

  .comments-sheet :global(.comment-form) {
    border-top: 1px solid var(--separator);
  }

  @media (hover: hover) {
    .sheet-close:hover {
      background: var(--hover-overlay);
    }
  }

  .caption {
    margin-left: var(--space-1);
    white-space: pre-line;
  }

  /* The markdown caption: its first paragraph runs on after her username, as on Instagram. */
  div.text {
    margin: 0;
  }

  div.caption {
    display: inline;
    white-space: normal;
  }

  div.caption :global(p) {
    margin: 0 0 var(--space-2);
  }

  div.caption :global(p:first-child) {
    display: inline;
  }

  div.caption :global(ul),
  div.caption :global(ol) {
    margin: var(--space-2) 0;
    padding-left: 1.2em;
  }

  div.caption :global(a) {
    color: var(--accent-text);
  }

  div.caption :global(code) {
    font-family: var(--font-mono);
    font-size: 0.92em;
  }

  .pinned .meta {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .actions {
    grid-area: actions;
    padding: var(--space-1) var(--space-2) var(--space-2);
  }

  @media (min-width: 768px) {
    .post-view {
      grid-template-columns: auto minmax(335px, 500px);
      grid-template-rows: auto minmax(0, 1fr) auto auto;
      grid-template-areas:
        'media head'
        'media comments'
        'media actions'
        'media compose';
    }

    .compose {
      border-left: 1px solid var(--separator);
    }

    .open-comments {
      display: none;
    }

    .comments .comment-list:not([hidden]) {
      display: grid;
    }

    .head,
    .comments,
    .actions {
      border-left: 1px solid var(--separator);
    }

    .head {
      border-bottom: 1px solid var(--separator);
    }

    .comments {
      overflow-y: auto;
      padding-top: var(--space-4);
    }

    .actions {
      border-top: 1px solid var(--separator);
    }

    .page {
      max-width: 935px;
      margin: 0 auto;
      border: 1px solid var(--separator);
      /* Split the column the page actually has (the side rail already took its share), so the
         media shrinks before the 335px details column is pushed off-screen. */
      grid-template-columns: minmax(0, 600px) minmax(335px, 1fr);
    }

    .page .media {
      width: 100%;
    }

    /* 4:5 media as tall as the viewport allows, leaving room for the 335px details column. */
    .modal {
      --media-h: min(calc(100dvh - 48px), 900px, calc((100vw - 128px - 335px) * 1.25));
    }

    .modal .media {
      width: calc(var(--media-h) * 0.8);
      height: var(--media-h);
      aspect-ratio: auto;
    }
  }
</style>
