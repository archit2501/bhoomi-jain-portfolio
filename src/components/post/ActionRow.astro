---
/**
 * The row under a post: like and copy-link, the likes line and the date. src/scripts/like.ts
 * brings the like to life; without JavaScript the buttons do nothing and the likes line stays
 * hidden, so nothing claims a like that can't happen.
 */
import Icon from '../Icon.astro';
import type { PostDate } from '../../lib/post-date';

interface Props {
  /** The post's slug: likes are remembered by it. */
  id: string;
  when?: PostDate;
  /** Anything else (the parent's scoped-style attribute among them) goes on the footer. */
  [attribute: string]: unknown;
}

const { id, when, class: className, ...attributes } = Astro.props;
---

<footer class:list={['action-row', className]} data-post={id} {...attributes}>
  <div class="buttons">
    <button class="like" type="button" aria-pressed="false" aria-label="Like">
      <Icon name="heart" class="heart-off" size={24} />
      <Icon name="heart" filled class="heart-on" size={24} />
    </button>
    <button class="comment" type="button" aria-label="Comment" data-needs-js>
      <Icon name="comment" size={24} />
    </button>
    <button class="share" type="button" aria-label="Copy link to this post" data-href={`/p/${id}/`}>
      <Icon name="link" size={24} />
    </button>
    <!-- Instagram's bookmark, at the far end: saved in this browser (src/scripts/save.ts). -->
    <button
      class="save"
      type="button"
      aria-pressed="false"
      aria-label="Save"
      data-save={id}
      data-needs-js
    >
      <Icon name="save" class="save-off" size={24} />
      <Icon name="save" filled class="save-on" size={24} />
    </button>
  </div>
  <p class="likes" hidden></p>
  {when && (
    <p class="date">
      {when.datetime ? <time datetime={when.datetime}>{when.text}</time> : when.text}
    </p>
  )}
  <p class="status visually-hidden" role="status"></p>
</footer>

<style>
  .buttons {
    display: flex;
  }

  .save {
    margin-left: auto;
  }

  .save :global(.save-on),
  .save[aria-pressed='true'] :global(.save-off) {
    display: none;
  }

  .save[aria-pressed='true'] :global(.save-on) {
    display: block;
  }

  .like,
  .comment,
  .share,
  .save {
    display: flex;
    padding: var(--space-2);
    color: var(--text);
    background: none;
    border: 0;
    border-radius: var(--radius-button);
    cursor: pointer;
  }

  :global(html:not(.js)) [data-needs-js] {
    display: none;
  }

  .like[aria-pressed='true'] {
    color: var(--like);
  }

  /* Outline heart until liked, then the filled one (it springs in: src/scripts/like.ts). */
  .like :global(.heart-on),
  .like[aria-pressed='true'] :global(.heart-off) {
    display: none;
  }

  .like[aria-pressed='true'] :global(.heart-on) {
    display: block;
  }

  .likes {
    margin: 0;
    padding: 0 var(--space-2) var(--space-1);
    font-weight: var(--weight-semibold);
  }

  /* The count rolls digit by digit when it changes (src/scripts/like.ts). */
  .likes :global(.odometer) {
    display: inline-flex;
    font-variant-numeric: tabular-nums;
  }

  .likes :global(.odometer-cell) {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
  }

  .likes :global(.odometer-cell > span) {
    display: inline-block;
  }

  .date {
    margin: 0;
    padding: 0 var(--space-2);
  }
</style>
