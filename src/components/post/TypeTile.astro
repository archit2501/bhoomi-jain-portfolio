---
interface Props {
  headline: string;
  detail?: string;
  /** 1: ocean-blue canvas, 2: slate canvas, 3: solid accent. Grid tiles rotate through them. */
  tone?: 1 | 2 | 3;
}

const { headline, detail, tone = 1 } = Astro.props;
// The headline shrinks so its longest word fits the tile, even where the browser can't hyphenate.
const longest = Math.max(...headline.split(/\s+/).map((word) => word.length));
---

<!-- A text post, Instagram "Create" style: type on a colour field, scaled to the tile. -->
<div class:list={['type-tile', `tone-${tone}`]} style={`--longest: ${longest}`}>
  <div class="content">
    <p class="headline">{headline}</p>
    {detail && <p class="detail">{detail}</p>}
  </div>
</div>

<style>
  .type-tile {
    container-type: inline-size;
    width: 100%;
    height: 100%;
    color: var(--on-story);
    font-family: var(--font-display);
  }

  .tone-1 {
    background: linear-gradient(160deg, var(--story-start), var(--story-end));
  }

  .tone-2 {
    background: linear-gradient(160deg, var(--tile-slate), var(--story-end));
  }

  .tone-3 {
    background: var(--accent);
  }

  .content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4cqi;
    height: 100%;
    padding: 9cqi;
  }

  .headline,
  .detail {
    margin: 0;
    /* Break long words at syllables ("Conversa-tional"), never at an arbitrary letter. */
    hyphens: auto;
    overflow-wrap: break-word;
    text-wrap: balance;
  }

  .headline {
    /* 82cqi of text width, at about 0.6em per bold character: 137cqi / characters. */
    font-size: clamp(12px, min(13cqi, calc(137cqi / var(--longest))), 48px);
    line-height: 1.1;
    font-weight: var(--weight-bold);
    letter-spacing: -0.02em;
  }

  .detail {
    font-size: clamp(11px, 5.5cqi, 20px);
    line-height: 1.3;
    letter-spacing: 0;
  }

  /* On the smallest phone tiles the detail line would be unreadable, so only the headline shows. */
  @container (max-width: 150px) {
    .detail {
      display: none;
    }
  }
</style>
