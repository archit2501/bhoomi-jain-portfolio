---
// Her content fonts (task 1.2.1). Each @font-face only downloads when text on the page uses it.
import '@fontsource-variable/geist-mono';
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/global.css';
import ContactSheet from '../components/ContactSheet.astro';
import Footer from '../components/Footer.astro';
import AppBar from '../components/nav/AppBar.astro';
import BottomTabs from '../components/nav/BottomTabs.astro';
import SideNav from '../components/nav/SideNav.astro';
import CreateSheet from '../components/panels/CreateSheet.astro';
import NotificationsPanel from '../components/panels/NotificationsPanel.astro';
import SearchPanel from '../components/panels/SearchPanel.astro';
import ShortcutsSheet from '../components/ShortcutsSheet.astro';
import type { NavId } from '../components/nav/nav-items';
import { loadSiteContent } from '../lib/content';
import { jsonLdScript, personJsonLd } from '../lib/seo';
import { pageTitle } from '../lib/site';
import { THEME_BOOT_SCRIPT } from '../lib/theme';

interface Props {
  /** Inner pages put their name first; the home page leaves this out. */
  title?: string;
  description?: string;
  /** Share-card image path, e.g. /og/p/revenue-100k.png; defaults to the profile card. */
  image?: string;
  type?: 'website' | 'article';
  current?: NavId;
  /** Full-screen pages (the reels feed): no phone top bar, as in the app. The footer stays. */
  immersive?: boolean;
  /** Private pages (a visitor's own conversation) stay out of search engines. */
  noindex?: boolean;
  /** An image that is this page's largest paint, fetched from the head before the body is read. */
  preload?: string;
}

// Full-screen media (reels) is black, and so is the browser's bar around it, as in the app.
const BLACK = '#000000';

const { profile } = await loadSiteContent();
const {
  title,
  description = `${profile.displayName}, ${profile.category} in ${profile.location}.`,
  image = '/og/default.png',
  type = 'website',
  current,
  immersive = false,
  noindex = false,
  preload,
} = Astro.props;
const fullTitle = pageTitle(title);
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
const person = jsonLdScript(personJsonLd(profile, new URL('/', Astro.site).href));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline set:html={THEME_BOOT_SCRIPT} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {preload && <link rel="preload" as="image" href={preload} fetchpriority="high" />}
    {immersive ? (
      <meta name="theme-color" content={BLACK} />
    ) : (
      <>
        <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#0c1014" media="(prefers-color-scheme: dark)" />
      </>
    )}
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={profile.displayName.split(/\s+/)[0]} />
    <title>{fullTitle}</title>
    <meta property="og:site_name" content={profile.displayName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="canonical" href={pageUrl} />
    <link rel="sitemap" href="/sitemap.xml" />
    <script type="application/ld+json" set:html={person} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <SideNav current={current} />
    {!immersive && <AppBar current={current} />}
    <div class="page">
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <Footer profile={profile} />
    </div>
    <BottomTabs current={current} />
    <ContactSheet profile={profile} />
    <SearchPanel />
    <ShortcutsSheet />
    <NotificationsPanel />
    <CreateSheet />
    <script>
      import '../scripts/media';
      import '../scripts/shell';
      import { initLive } from '../scripts/live';

      initLive();

      // Installable, and an offline page when the network is gone (public/sw.js).
      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        addEventListener(
          'load',
          () => void navigator.serviceWorker.register('/sw.js').catch(() => {}),
        );
      }
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 100;
    padding: var(--space-2) var(--space-4);
    color: var(--on-accent);
    background: var(--accent);
    font-weight: var(--weight-semibold);
    border-radius: var(--radius-button);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  .page {
    min-height: 100dvh;
    padding-bottom: calc(var(--bottom-bar-h) + env(safe-area-inset-bottom, 0px));
  }

  @media (min-width: 768px) {
    .page {
      margin-left: 72px;
      padding-bottom: 0;
    }
  }

  @media (min-width: 1264px) {
    .page {
      margin-left: 244px;
    }
  }

  main:focus {
    outline: none;
  }
</style>
