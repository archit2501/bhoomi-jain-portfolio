---
import '../styles/global.css';
import ContactSheet from '../components/ContactSheet.astro';
import Footer from '../components/Footer.astro';
import AppBar from '../components/nav/AppBar.astro';
import BottomTabs from '../components/nav/BottomTabs.astro';
import SideNav from '../components/nav/SideNav.astro';
import type { NavId } from '../components/nav/nav-items';
import { loadSiteContent } from '../lib/content';
import { jsonLdScript, personJsonLd } from '../lib/seo';
import { pageTitle } from '../lib/site';

interface Props {
  /** Inner pages put their name first; the home page leaves this out. */
  title?: string;
  description?: string;
  /** Share-card image path, e.g. /og/p/revenue-100k.png; defaults to the profile card. */
  image?: string;
  type?: 'website' | 'article';
  current?: NavId;
}

const { profile } = await loadSiteContent();
const {
  title,
  description = `${profile.displayName}, ${profile.category} in ${profile.location}.`,
  image = '/og/default.png',
  type = 'website',
  current,
} = Astro.props;
const fullTitle = pageTitle(title);
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
const person = jsonLdScript(personJsonLd(profile, new URL('/', Astro.site).href));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c1014" media="(prefers-color-scheme: dark)" />
    <title>{fullTitle}</title>
    <meta property="og:site_name" content={profile.displayName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={pageUrl} />
    <link rel="sitemap" href="/sitemap.xml" />
    <script type="application/ld+json" set:html={person} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <SideNav current={current} />
    <AppBar />
    <div class="page">
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <Footer profile={profile} />
    </div>
    <BottomTabs current={current} />
    <ContactSheet profile={profile} />
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 100;
    padding: var(--space-2) var(--space-4);
    color: var(--on-accent);
    background: var(--accent);
    font-weight: var(--weight-semibold);
    border-radius: var(--radius-button);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  .page {
    min-height: 100dvh;
    padding-bottom: calc(49px + env(safe-area-inset-bottom, 0px));
  }

  @media (min-width: 768px) {
    .page {
      margin-left: 72px;
      padding-bottom: 0;
    }
  }

  @media (min-width: 1264px) {
    .page {
      margin-left: 244px;
    }
  }

  main:focus {
    outline: none;
  }
</style>
