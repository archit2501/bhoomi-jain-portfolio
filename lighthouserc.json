{
  "ci": {
    "collect": {
      "staticDistDir": "./dist/client",
      "numberOfRuns": 3,
      "url": [
        "http://localhost/index.html",
        "http://localhost/feed/index.html",
        "http://localhost/explore/index.html",
        "http://localhost/reels/index.html",
        "http://localhost/p/smartblog-ai/index.html",
        "http://localhost/stories/projects/index.html",
        "http://localhost/direct/index.html",
        "http://localhost/insights/index.html",
        "http://localhost/notifications/index.html",
        "http://localhost/404.html"
      ]
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2000
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
