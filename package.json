{
  "name": "bhoomi-jain-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "type-check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun",
    "budget": "node scripts/js-budget.mjs dist/client 40",
    "content:review": "node scripts/content-review.mjs > docs/content-review.md && prettier --write docs/content-review.md",
    "deploy": "astro build && wrangler deploy",
    "prebuild": "node scripts/placeholders.mjs",
    "predev": "node scripts/placeholders.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.1",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "astro": "^7.4.1",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "sharp": "0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.151.3",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
